#version 460
#extension GL_GOOGLE_include_directive : require

#include "srgb.inc.glsl"


// The size of the distortion texture dimensions in texels.
layout(constant_id = 0) const int distortion_texel_count = 2;

// Should we do timewarp.
layout(constant_id = 1) const bool do_timewarp = false;
// For NONE-distortion devices, bypass sampled distortion textures entirely.
layout(constant_id = 2) const bool use_identity_distortion = false;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Color sources are [0..1], corresponding depth sources are [2..3].
layout(set = 0, binding = 0) uniform sampler2D source[4];
layout(set = 0, binding = 1) uniform sampler2D distortion[6];
layout(set = 0, binding = 2) uniform writeonly restrict image2D target;
layout(set = 0, binding = 4, std430) readonly buffer Visibility
{
	uint depth_bits[];
} visibility;
layout(set = 0, binding = 3, std140) uniform restrict Config
{
	ivec4 views[2];
	vec4 pre_transform[2];
	vec4 post_transform[2];
	mat4 transform_timewarp_scanout_begin[2];
	mat4 transform_timewarp_scanout_end[2];

	vec4 depth_post_transform[2];
	vec4 source_uv_to_tanangle[2];
	vec4 projection_depth[2];
	vec4 new_origin_in_source_view_scanout_begin[2];
	vec4 new_origin_in_source_view_scanout_end[2];
	vec4 target_to_source_orientation_scanout_begin[2];
	vec4 target_to_source_orientation_scanout_end[2];
	uvec4 has_depth[2];
	uvec4 depth_debug;
	uvec4 depth_visibility;
}ubo;


vec2 position_to_subimage_uv(ivec2 extent, uint ix, uint iy)
{
	// Turn the index into floating point.
	vec2 xy = vec2(float(ix), float(iy));

	// The inverse of the extent of the target image is the pixel size in [0 .. 1] space.
	vec2 extent_pixel_size = vec2(1.0 / float(extent.x), 1.0 / float(extent.y));

	// Per-target pixel we move the size of the pixels.
	vec2 uv = xy * extent_pixel_size;

	// Emulate a triangle sample position by offset half target pixel size.
	uv = uv + extent_pixel_size / 2.0;

	return uv;
}

vec2 position_to_distortion_uv(ivec2 extent, uint ix, uint iy)
{
	vec2 dist_uv = position_to_subimage_uv(extent, ix, iy);


	// To correctly sample we need to put position (0, 0) in the
	// middle of the (0, 0) texel in the distortion textures. That's why we
	// offset with half the texel size, pushing all samples into the middle
	// of each texels, a kin to a vertex buffer. We need to put uv coord
	// (1, 1) in the middle of the last texel, that pixel is (size - 1)
	// texels away from the first texel. So we need to scale [0 .. 1] to
	// [0 .. size - 1].

#define DIM (float(distortion_texel_count))
#define STRETCH ((DIM - 1.0) / DIM)
#define OFFSET (1.0 / (DIM * 2.0))

	dist_uv = (dist_uv * STRETCH) + OFFSET;

	return dist_uv;
}

vec2 transform_uv_subimage(vec2 uv, uint iz)
{
	vec2 values = uv;

	// To deal with OpenGL flip and sub image view.
	values.xy = values.xy * ubo.post_transform[iz].zw + ubo.post_transform[iz].xy;

	// Ready to be used.
	return values.xy;
}

vec2 transform_uv_timewarp(vec2 uv, uint iz)
{
	vec4 values = vec4(uv, -1, 1);

	// From uv to tan angle (tangent space).
	values.xy = values.xy * ubo.pre_transform[iz].zw + ubo.pre_transform[iz].xy;
	values.y = -values.y; // Flip to OpenXR coordinate system.

	// Timewarp including scanline timewarp for rolling refresh panels.
	values = ubo.transform_timewarp_scanout_begin[iz] * values * (1 - uv.y) +
	         ubo.transform_timewarp_scanout_end[iz] * values * uv.y;
	values.xy = values.xy * (1.0 / max(values.w, 0.00001));

	// From [-1, 1] to [0, 1]
	values.xy = values.xy * 0.5 + 0.5;

	// Done.
	return values.xy;
}

float projection_depth_to_view_z_distance(float window_depth, vec4 depth_info)
{
	const float min_depth = depth_info.x;
	const float max_depth = depth_info.y;
	const float near_z = depth_info.z;
	const float far_z = depth_info.w;

	const float range = max_depth - min_depth;
	if (!(range > 0.0) || !(near_z > 0.0) || !(far_z > 0.0)) {
		return 0.0;
	}

	const float t = clamp((window_depth - min_depth) / range, 0.0, 1.0);
	const float inverse_distance = mix(1.0 / near_z, 1.0 / far_z, t);
	return inverse_distance > 1e-8 ? 1.0 / inverse_distance : 0.0;
}

vec2 depth_translate_projection_uv(vec2 rotational_source_uv,
                                  float source_z_distance,
                                  vec3 source_origin,
                                  uint iz)
{
	vec2 tangent_extent = ubo.source_uv_to_tanangle[iz].zw;
	if (abs(tangent_extent.x) < 1e-6 || abs(tangent_extent.y) < 1e-6 ||
	    !(source_z_distance > 0.0)) {
		return rotational_source_uv;
	}

	vec2 source_tan =
	    fma(rotational_source_uv, tangent_extent, ubo.source_uv_to_tanangle[iz].xy);

	// Source-view rays are (tanX, -tanY, -1). Orientation has already been
	// handled by rotational timewarp; only the translated camera origin remains.
	float ray_scale = source_z_distance + source_origin.z;
	if (!(ray_scale > 0.0)) {
		return rotational_source_uv;
	}

	vec2 corrected_tan = vec2(
	    (source_origin.x + ray_scale * source_tan.x) / source_z_distance,
	    (-source_origin.y + ray_scale * source_tan.y) / source_z_distance);

	return (corrected_tan - ubo.source_uv_to_tanangle[iz].xy) / tangent_extent;
}

bool depth_solve_projection(float scanout_fraction,
                            vec2 rotational_green_uv,
                            uint iz,
                            out float solved_z_distance,
                            out vec3 source_origin,
                            out vec2 corrected_green_uv,
                            out float initial_z_distance,
                            out float refined_z_distance,
                            out vec2 first_corrected_uv,
                            out bool refinement_oscillated)
{
	solved_z_distance = 0.0;
	source_origin = vec3(0.0);
	corrected_green_uv = rotational_green_uv;
	initial_z_distance = 0.0;
	refined_z_distance = 0.0;
	first_corrected_uv = rotational_green_uv;
	refinement_oscillated = false;

	if (any(lessThan(rotational_green_uv, vec2(0.0))) ||
	    any(greaterThan(rotational_green_uv, vec2(1.0)))) {
		return false;
	}

	vec2 depth_uv = fma(rotational_green_uv, ubo.depth_post_transform[iz].zw,
	                    ubo.depth_post_transform[iz].xy);
	float window_depth = texture(source[2 + iz], depth_uv).r;
	float source_z_distance =
	    projection_depth_to_view_z_distance(window_depth, ubo.projection_depth[iz]);
	initial_z_distance = source_z_distance;
	if (!(source_z_distance > 0.0)) {
		return false;
	}

	source_origin =
	    mix(ubo.new_origin_in_source_view_scanout_begin[iz].xyz,
	        ubo.new_origin_in_source_view_scanout_end[iz].xyz, scanout_fraction);

	vec2 corrected_uv =
	    depth_translate_projection_uv(rotational_green_uv, source_z_distance, source_origin, iz);
	first_corrected_uv = corrected_uv;
	if (any(lessThan(corrected_uv, vec2(0.0))) ||
	    any(greaterThan(corrected_uv, vec2(1.0)))) {
		return false;
	}

	/*
	 * One fixed-point refinement: sample the depth surface reached by the first
	 * translated estimate, then solve the same green ray against that surface.
	 */
	vec2 corrected_depth_uv =
	    fma(corrected_uv, ubo.depth_post_transform[iz].zw, ubo.depth_post_transform[iz].xy);
	float refined_window_depth = texture(source[2 + iz], corrected_depth_uv).r;
	refined_z_distance =
	    projection_depth_to_view_z_distance(refined_window_depth, ubo.projection_depth[iz]);
	if (refined_z_distance > 0.0) {
		vec2 refined_uv =
		    depth_translate_projection_uv(rotational_green_uv, refined_z_distance, source_origin, iz);
		if (all(greaterThanEqual(refined_uv, vec2(0.0))) &&
		    all(lessThanEqual(refined_uv, vec2(1.0)))) {
			/*
			 * A foreground/background boundary can produce a two-cycle:
			 * z0 -> UV1 lands on z1, then z1 -> UV2 lands back on z0.
			 * Accepting UV2 while assuming z1 gives exactly the moving
			 * outline/shadow seen in the diagnostic scene. Only pay for a
			 * third depth fetch when the refinement actually changed
			 * surfaces, and accept the refined candidate only if its own
			 * landing point agrees with z1.
			 */
			float reference_z = min(source_z_distance, refined_z_distance);
			float switch_tolerance = max(0.05, 0.20 * reference_z);
			bool surface_switch =
			    abs(refined_z_distance - source_z_distance) > switch_tolerance;
			bool accept_refined = true;

			if (surface_switch) {
				vec2 verify_depth_uv =
				    fma(refined_uv, ubo.depth_post_transform[iz].zw, ubo.depth_post_transform[iz].xy);
				float verify_window_depth = texture(source[2 + iz], verify_depth_uv).r;
				float verify_z_distance =
				    projection_depth_to_view_z_distance(verify_window_depth, ubo.projection_depth[iz]);
				float verify_reference_z =
				    verify_z_distance > 0.0 ? min(refined_z_distance, verify_z_distance) : refined_z_distance;
				float verify_tolerance = max(0.05, 0.20 * verify_reference_z);
				accept_refined =
				    verify_z_distance > 0.0 &&
				    abs(verify_z_distance - refined_z_distance) <= verify_tolerance;
				refinement_oscillated = !accept_refined;
			}

			if (accept_refined) {
				corrected_uv = refined_uv;
				source_z_distance = refined_z_distance;
			}
		}
	}

	solved_z_distance = source_z_distance;
	corrected_green_uv = corrected_uv;
	return true;
}

bool depth_find_nearer_occluder(vec2 rotational_source_uv,
                                  uint iz,
                                  vec3 source_origin,
                                  float current_z_distance,
                                  out vec2 out_uv,
                                  out float out_z_distance)
{
	out_uv = rotational_source_uv;
	out_z_distance = current_z_distance;

	if (ubo.depth_debug.w == 0u || !(current_z_distance > 0.0)) {
		return false;
	}

	vec2 tangent_extent = ubo.source_uv_to_tanangle[iz].zw;
	if (abs(tangent_extent.x) < 1e-6 || abs(tangent_extent.y) < 1e-6) {
		return false;
	}

	vec2 source_tan =
	    fma(rotational_source_uv, tangent_extent, ubo.source_uv_to_tanangle[iz].xy);

	/*
	 * The source-image displacement produced by translation is proportional to
	 * 1/depth. Its direction is therefore independent of depth:
	 *
	 *   delta_tan = (origin.xy + origin.z * ray.xy) / depth
	 *
	 * Search only along that epipolar/translation direction. Four probes are
	 * enough to discover a nearer surface over the displacement range expected
	 * from one or two missed compositor frames without turning this into a full
	 * neighbourhood search.
	 */
	vec2 delta_uv_per_inv_m = vec2(
	    source_origin.x + source_origin.z * source_tan.x,
	    -source_origin.y + source_origin.z * source_tan.y) / tangent_extent;

	vec2 source_size = vec2(textureSize(source[2 + iz], 0));
	vec2 delta_px_per_inv_m = delta_uv_per_inv_m * source_size;
	float delta_len = length(delta_px_per_inv_m);
	if (delta_len < 0.25) {
		return false;
	}

	vec2 direction_px = delta_px_per_inv_m / delta_len;
	// Search as though surfaces as near as 0.40 m may occlude the current
	// candidate. Use roughly one probe per eight source pixels, capped at
	// sixteen probes and 384 pixels. Normal late-reprojection motion therefore
	// stays cheap, while the frozen-frame stress test can cover much larger
	// translations than the old fixed 64-pixel window.
	float min_search_z = max(ubo.projection_depth[iz].z, 0.40);
	float max_shift_px = clamp(delta_len / min_search_z, 1.0, 384.0);
	int probe_count = int(clamp(ceil(max_shift_px / 8.0), 1.0, 16.0));
	float probe_step_px = max_shift_px / float(probe_count);

	bool found = false;
	float best_z = current_z_distance;
	vec2 best_uv = rotational_source_uv;

	for (int i = 0; i < 16; ++i) {
		if (i >= probe_count) {
			break;
		}
		float probe_distance_px = probe_step_px * float(i + 1);
		vec2 probe_uv = rotational_source_uv +
		                direction_px * probe_distance_px / source_size;
		if (any(lessThan(probe_uv, vec2(0.0))) ||
		    any(greaterThan(probe_uv, vec2(1.0)))) {
			continue;
		}

		vec2 probe_depth_uv =
		    fma(probe_uv, ubo.depth_post_transform[iz].zw, ubo.depth_post_transform[iz].xy);
		float probe_window_depth = texture(source[2 + iz], probe_depth_uv).r;
		float probe_z =
		    projection_depth_to_view_z_distance(probe_window_depth, ubo.projection_depth[iz]);

		float nearer_margin = max(0.02, 0.03 * best_z);
		if (!(probe_z > 0.0) || !(probe_z + nearer_margin < best_z)) {
			continue;
		}

		vec2 candidate_uv =
		    depth_translate_projection_uv(rotational_source_uv, probe_z, source_origin, iz);
		if (any(lessThan(candidate_uv, vec2(0.0))) ||
		    any(greaterThan(candidate_uv, vec2(1.0)))) {
			continue;
		}

		// The probe only discovers a possible surface depth. Require the exact
		// source location implied by that depth to land on the same surface.
		vec2 candidate_depth_uv =
		    fma(candidate_uv, ubo.depth_post_transform[iz].zw, ubo.depth_post_transform[iz].xy);
		float candidate_window_depth = texture(source[2 + iz], candidate_depth_uv).r;
		float candidate_z =
		    projection_depth_to_view_z_distance(candidate_window_depth, ubo.projection_depth[iz]);
		float consistency_tolerance = max(0.025, 0.06 * min(probe_z, candidate_z));
		if (!(candidate_z > 0.0) ||
		    abs(candidate_z - probe_z) > consistency_tolerance) {
			continue;
		}

		best_z = candidate_z;
		best_uv = candidate_uv;
		found = true;
	}

	if (found) {
		out_uv = best_uv;
		out_z_distance = best_z;
	}
	return found;
}

bool depth_resolve_visibility(float scanout_fraction,
                              vec2 rotational_source_uv,
                              uint iz,
                              out float selected_z_distance,
                              out vec3 source_origin,
                              out vec2 selected_uv)
{
	float solved_z_distance;
	float initial_z_distance;
	float refined_z_distance;
	vec2 corrected_uv;
	vec2 first_corrected_uv;
	bool refinement_oscillated;

	bool depth_solved = depth_solve_projection(scanout_fraction,
	                                          rotational_source_uv,
	                                          iz,
	                                          solved_z_distance,
	                                          source_origin,
	                                          corrected_uv,
	                                          initial_z_distance,
	                                          refined_z_distance,
	                                          first_corrected_uv,
	                                          refinement_oscillated);
	if (!depth_solved) {
		selected_z_distance = 0.0;
		selected_uv = rotational_source_uv;
		return false;
	}

	selected_z_distance = solved_z_distance;
	selected_uv = corrected_uv;

	// Background-biased handling of A<->B cycles.
	if (ubo.depth_debug.y != 0u && refinement_oscillated &&
	    initial_z_distance > refined_z_distance) {
		selected_z_distance = initial_z_distance;
		selected_uv = rotational_source_uv;
	}

	// Recover foreground that has moved into this output pixel. This is a
	// single geometric visibility decision and is intentionally performed on
	// the green/central ray when shared visibility is enabled.
	vec2 occluder_uv;
	float occluder_z;
	if (depth_find_nearer_occluder(rotational_source_uv,
	                               iz,
	                               source_origin,
	                               selected_z_distance,
	                               occluder_uv,
	                               occluder_z)) {
		selected_z_distance = occluder_z;
		selected_uv = occluder_uv;
	}

	return true;
}

vec2 depth_resolve_projection_uv(float scanout_fraction,
                                 vec2 rotational_source_uv,
                                 uint iz)
{
	float selected_z_distance;
	vec3 source_origin;
	vec2 selected_uv;
	if (!depth_resolve_visibility(scanout_fraction,
	                              rotational_source_uv,
	                              iz,
	                              selected_z_distance,
	                              source_origin,
	                              selected_uv)) {
		return rotational_source_uv;
	}
	return selected_uv;
}

vec3 quat_rotate(vec4 q, vec3 v)
{
	return v + 2.0 * cross(q.xyz, cross(q.xyz, v) + q.w * v);
}

bool depth_visibility_decode(uint encoded, out float target_z)
{
	if (encoded == 0x7f7fffffu) {
		target_z = 0.0;
		return false;
	}
	target_z = uintBitsToFloat(encoded);
	return target_z > 0.0 && target_z < 1e20;
}

bool depth_visibility_target_z(vec2 target_projection_uv,
                               uint iz,
                               out float target_z)
{
	target_z = 0.0;
	if (ubo.depth_visibility.w == 0u ||
	    any(lessThan(target_projection_uv, vec2(0.0))) ||
	    any(greaterThanEqual(target_projection_uv, vec2(1.0)))) {
		return false;
	}

	uint width = ubo.depth_visibility.x;
	uint height = ubo.depth_visibility.y;
	if (width == 0u || height == 0u || iz >= ubo.depth_visibility.z) {
		return false;
	}

	uvec2 pixel = min(uvec2(target_projection_uv * vec2(width, height)),
	                  uvec2(width - 1u, height - 1u));
	uint base = iz * width * height;
	uint encoded = visibility.depth_bits[base + pixel.y * width + pixel.x];
	if (depth_visibility_decode(encoded, target_z)) {
		return true;
	}

	if (ubo.has_depth[iz].z == 0u) {
		return false;
	}

	// Forward splatting can leave narrow holes at disocclusions. Probe a small
	// neighbourhood only for missing pixels and choose the farthest valid
	// surface: a hole created by foreground motion should reveal background,
	// not resurrect the old foreground position.
	const ivec2 directions[8] = ivec2[8](
	    ivec2(1, 0), ivec2(-1, 0), ivec2(0, 1), ivec2(0, -1),
	    ivec2(1, 1), ivec2(-1, 1), ivec2(1, -1), ivec2(-1, -1));
	const int radii[4] = int[4](1, 2, 4, 8);
	float farthest_z = 0.0;
	bool found = false;
	ivec2 max_pixel = ivec2(int(width) - 1, int(height) - 1);

	for (int r = 0; r < 4; ++r) {
		for (int d = 0; d < 8; ++d) {
			ivec2 p = clamp(ivec2(pixel) + directions[d] * radii[r], ivec2(0), max_pixel);
			uint neighbour_encoded =
			    visibility.depth_bits[base + uint(p.y) * width + uint(p.x)];
			float neighbour_z;
			if (depth_visibility_decode(neighbour_encoded, neighbour_z) &&
			    (!found || neighbour_z > farthest_z)) {
				farthest_z = neighbour_z;
				found = true;
			}
		}
	}

	if (found) {
		target_z = farthest_z;
	}
	return found;
}

float depth_source_z_at_projection_uv(vec2 projection_uv, uint iz)
{
	if (any(lessThan(projection_uv, vec2(0.0))) ||
	    any(greaterThan(projection_uv, vec2(1.0)))) {
		return 0.0;
	}
	vec2 depth_uv =
	    fma(projection_uv, ubo.depth_post_transform[iz].zw, ubo.depth_post_transform[iz].xy);
	float window_depth = texture(source[2 + iz], depth_uv).r;
	return projection_depth_to_view_z_distance(window_depth, ubo.projection_depth[iz]);
}

bool depth_snap_source_uv_to_surface(vec2 candidate_uv,
                                     float expected_source_z,
                                     uint iz,
                                     out vec2 snapped_uv)
{
	snapped_uv = candidate_uv;
	if (!(expected_source_z > 0.0) ||
	    any(lessThan(candidate_uv, vec2(0.0))) ||
	    any(greaterThan(candidate_uv, vec2(1.0)))) {
		return false;
	}

	float candidate_z = depth_source_z_at_projection_uv(candidate_uv, iz);
	float tolerance = max(0.025, 0.05 * expected_source_z);
	if (candidate_z > 0.0 && abs(candidate_z - expected_source_z) <= tolerance) {
		return true;
	}

	vec2 depth_scale = abs(ubo.depth_post_transform[iz].zw);
	vec2 depth_size = vec2(textureSize(source[2 + iz], 0));
	if (depth_scale.x < 1e-6 || depth_scale.y < 1e-6 ||
	    depth_size.x < 1.0 || depth_size.y < 1.0) {
		return false;
	}
	vec2 projection_texel = 1.0 / (depth_size * depth_scale);

	const ivec2 directions[8] = ivec2[8](
	    ivec2(1, 0), ivec2(-1, 0), ivec2(0, 1), ivec2(0, -1),
	    ivec2(1, 1), ivec2(-1, 1), ivec2(1, -1), ivec2(-1, -1));
	const int radii[4] = int[4](1, 2, 4, 8);
	float best_error = 1e30;
	vec2 best_uv = candidate_uv;

	for (int r = 0; r < 4; ++r) {
		for (int d = 0; d < 8; ++d) {
			vec2 uv = candidate_uv + vec2(directions[d] * radii[r]) * projection_texel;
			if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) {
				continue;
			}
			float z = depth_source_z_at_projection_uv(uv, iz);
			if (!(z > 0.0)) {
				continue;
			}
			float error = abs(z - expected_source_z);
			if (error < best_error) {
				best_error = error;
				best_uv = uv;
			}
		}
	}

	if (best_error <= tolerance) {
		snapped_uv = best_uv;
		return true;
	}
	return false;
}

vec2 depth_source_uv_from_target_z(vec2 target_projection_uv,
                                   float target_z,
                                   float scanout_fraction,
                                   uint iz,
                                   out float source_z)
{
	source_z = 0.0;
	vec2 target_extent = ubo.pre_transform[iz].zw;
	vec2 source_extent = ubo.source_uv_to_tanangle[iz].zw;
	if (abs(target_extent.x) < 1e-6 || abs(target_extent.y) < 1e-6 ||
	    abs(source_extent.x) < 1e-6 || abs(source_extent.y) < 1e-6 ||
	    !(target_z > 0.0)) {
		return vec2(-1.0);
	}

	vec2 target_tan =
	    fma(target_projection_uv, target_extent, ubo.pre_transform[iz].xy);
	vec3 target_point =
	    vec3(target_tan.x * target_z, -target_tan.y * target_z, -target_z);

	vec4 q = normalize(mix(ubo.target_to_source_orientation_scanout_begin[iz],
	                       ubo.target_to_source_orientation_scanout_end[iz],
	                       scanout_fraction));
	vec3 origin = mix(ubo.new_origin_in_source_view_scanout_begin[iz].xyz,
	                  ubo.new_origin_in_source_view_scanout_end[iz].xyz,
	                  scanout_fraction);
	vec3 source_point = quat_rotate(q, target_point) + origin;
	source_z = -source_point.z;
	if (!(source_z > 1e-6)) {
		source_z = 0.0;
		return vec2(-1.0);
	}

	vec2 source_tan = vec2(source_point.x / source_z, -source_point.y / source_z);
	return (source_tan - ubo.source_uv_to_tanangle[iz].xy) / source_extent;
}

vec2 transform_uv(vec2 uv, uint iz)
{
	if (do_timewarp) {
		uv = transform_uv_timewarp(uv, iz);
	}

	return transform_uv_subimage(uv, iz);
}

void main()
{
	uint ix = gl_GlobalInvocationID.x;
	uint iy = gl_GlobalInvocationID.y;
	uint iz = gl_GlobalInvocationID.z;

	ivec2 offset = ivec2(ubo.views[iz].xy);
	ivec2 extent = ivec2(ubo.views[iz].zw);

	if (ix >= extent.x || iy >= extent.y) {
		return;
	}

	vec2 subimage_uv = position_to_subimage_uv(extent, ix, iy);
	vec2 distortion_uv = position_to_distortion_uv(extent, ix, iy);

	vec2 r_uv = use_identity_distortion ? subimage_uv : texture(distortion[iz + 0], distortion_uv).xy;
	vec2 g_uv = use_identity_distortion ? subimage_uv : texture(distortion[iz + 2], distortion_uv).xy;
	vec2 b_uv = use_identity_distortion ? subimage_uv : texture(distortion[iz + 4], distortion_uv).xy;

	// Keep target projection UVs separate from source/subimage mapping.
	if (do_timewarp) {
		vec2 r_target_uv = r_uv;
		vec2 g_target_uv = g_uv;
		vec2 b_target_uv = b_uv;

		// Diagnostic only: suppress the raw panel-space chromatic offsets while
		// debugging geometry. This is not suitable as the normal HMD path because
		// the lens requires chromatic-aberration correction.
		if (ubo.has_depth[iz].w != 0u) {
			r_target_uv = g_target_uv;
			b_target_uv = g_target_uv;
		}

		vec2 r_projection_uv = transform_uv_timewarp(r_target_uv, iz);
		vec2 g_projection_uv = transform_uv_timewarp(g_target_uv, iz);
		vec2 b_projection_uv = transform_uv_timewarp(b_target_uv, iz);
		bool forward_enabled =
		    ubo.has_depth[iz].x != 0u &&
		    ubo.depth_visibility.w != 0u &&
		    ubo.depth_debug.x == 0u;

		if (forward_enabled) {
			float target_z;
			if (depth_visibility_target_z(g_target_uv, iz, target_z)) {
				float expected_r_z;
				float expected_g_z;
				float expected_b_z;
				vec2 candidate_r =
				    depth_source_uv_from_target_z(r_target_uv, target_z, subimage_uv.y, iz, expected_r_z);
				vec2 candidate_g =
				    depth_source_uv_from_target_z(g_target_uv, target_z, subimage_uv.y, iz, expected_g_z);
				vec2 candidate_b =
				    depth_source_uv_from_target_z(b_target_uv, target_z, subimage_uv.y, iz, expected_b_z);

				vec2 snapped_g;
				bool green_matches =
				    depth_snap_source_uv_to_surface(candidate_g, expected_g_z, iz, snapped_g);
				if (green_matches) {
					g_projection_uv = snapped_g;
					r_projection_uv = candidate_r;
					b_projection_uv = candidate_b;

					// A chromatic ray is allowed its optical offset only while it
					// remains on the same geometric surface. At a depth edge, locking
					// the offending channel to green prevents a neighbouring cyan/wall
					// surface leaking through an orange silhouette.
					if (ubo.has_depth[iz].y != 0u) {
						vec2 snapped_r;
						vec2 snapped_b;
						if (!depth_snap_source_uv_to_surface(candidate_r, expected_r_z, iz, snapped_r)) {
							r_projection_uv = snapped_g;
						} else {
							r_projection_uv = snapped_r;
						}
						if (!depth_snap_source_uv_to_surface(candidate_b, expected_b_z, iz, snapped_b)) {
							b_projection_uv = snapped_g;
						} else {
							b_projection_uv = snapped_b;
						}
					}

				}
			}
		}

		if (!forward_enabled && ubo.has_depth[iz].x != 0u) {
			// Legacy inverse-search path retained only for A/B testing and depth
			// diagnostics. The normal forward path deliberately never drops into
			// this ambiguous solver for a missing visibility pixel.
			if (ubo.depth_debug.x != 0u) {
				float solved_z_distance;
				float initial_z_distance;
				float refined_z_distance;
				vec3 source_origin;
				vec2 corrected_g;
				vec2 first_corrected_g;
				bool refinement_oscillated;
				bool depth_solved = depth_solve_projection(subimage_uv.y,
				                                           g_projection_uv,
				                                           iz,
				                                           solved_z_distance,
				                                           source_origin,
				                                           corrected_g,
				                                           initial_z_distance,
				                                           refined_z_distance,
				                                           first_corrected_g,
				                                           refinement_oscillated);

				vec4 debug_colour = vec4(0.0, 0.0, 1.0, 1.0);
				if (ubo.depth_debug.x == 1u) {
					if (initial_z_distance > 0.0) {
						float near_z = max(ubo.projection_depth[iz].z, 1e-4);
						float far_z = max(ubo.projection_depth[iz].w, near_z + 1e-4);
						float depth_level =
						    clamp(log(initial_z_distance / near_z) / log(far_z / near_z), 0.0, 1.0);
						debug_colour = vec4(vec3(depth_level), 1.0);
					}
				} else if (ubo.depth_debug.x == 2u) {
					if (depth_solved) {
						float reference_z =
						    refined_z_distance > 0.0 ? min(initial_z_distance, refined_z_distance)
						                             : initial_z_distance;
						float allowed_jump = max(0.05, 0.20 * reference_z);
						bool surface_switch =
						    refined_z_distance > 0.0 &&
						    abs(refined_z_distance - initial_z_distance) > allowed_jump;
						if (refinement_oscillated) {
							debug_colour = vec4(1.0, 0.0, 1.0, 1.0);
						} else if (surface_switch) {
							debug_colour = vec4(1.0, 1.0, 0.0, 1.0);
						} else {
							debug_colour = vec4(0.35, 0.35, 0.35, 1.0);
						}
					}
				} else if (ubo.depth_debug.x == 3u) {
					if (depth_solved) {
						vec2 source_size = vec2(textureSize(source[iz], 0));
						float delta_px =
						    length((corrected_g - first_corrected_g) * source_size);
						float heat = clamp(delta_px / 4.0, 0.0, 1.0);
						debug_colour = vec4(heat, 0.0, 0.0, 1.0);
					}
				}
				imageStore(target, ivec2(offset.x + ix, offset.y + iy), debug_colour);
				return;
			}

			if (ubo.depth_debug.z != 0u) {
				r_projection_uv =
				    depth_resolve_projection_uv(subimage_uv.y, r_projection_uv, iz);
				g_projection_uv =
				    depth_resolve_projection_uv(subimage_uv.y, g_projection_uv, iz);
				b_projection_uv =
				    depth_resolve_projection_uv(subimage_uv.y, b_projection_uv, iz);
			} else {
				float selected_z_distance;
				vec3 source_origin;
				vec2 selected_g;
				if (depth_resolve_visibility(subimage_uv.y,
				                             g_projection_uv,
				                             iz,
				                             selected_z_distance,
				                             source_origin,
				                             selected_g)) {
					vec2 corrected_r =
					    depth_translate_projection_uv(r_projection_uv,
					                                  selected_z_distance,
					                                  source_origin,
					                                  iz);
					vec2 corrected_b =
					    depth_translate_projection_uv(b_projection_uv,
					                                  selected_z_distance,
					                                  source_origin,
					                                  iz);
					if (all(greaterThanEqual(corrected_r, vec2(0.0))) &&
					    all(lessThanEqual(corrected_r, vec2(1.0)))) {
						r_projection_uv = corrected_r;
					}
					g_projection_uv = selected_g;
					if (all(greaterThanEqual(corrected_b, vec2(0.0))) &&
					    all(lessThanEqual(corrected_b, vec2(1.0)))) {
						b_projection_uv = corrected_b;
					}
				}
			}
		}

		// If forward visibility was enabled but no trustworthy correspondence
		// could be reconstructed, the UVs remain at the already-computed
		// rotation-only positions. This is deliberately conservative: a small
		// stale patch is preferable to inventing a duplicate foreground surface.

		r_uv = transform_uv_subimage(r_projection_uv, iz);
		g_uv = transform_uv_subimage(g_projection_uv, iz);
		b_uv = transform_uv_subimage(b_projection_uv, iz);
	} else {
		r_uv = transform_uv_subimage(r_uv, iz);
		g_uv = transform_uv_subimage(g_uv, iz);
		b_uv = transform_uv_subimage(b_uv, iz);
	}

	// Preserve source alpha instead of forcing the compositor target opaque.
	vec4 colour = vec4(              //
	    texture(source[iz], r_uv).r, //
	    texture(source[iz], g_uv).g, //
	    texture(source[iz], b_uv).b, //
	    texture(source[iz], g_uv).a); //

	// Do colour correction here since there are no automatic conversion in hardware available.
	colour = vec4(from_linear_to_srgb(colour.rgb), colour.a);

	imageStore(target, ivec2(offset.x + ix, offset.y + iy), colour);
}
