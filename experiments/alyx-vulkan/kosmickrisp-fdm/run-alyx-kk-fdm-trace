#!/bin/sh
# Opt-in full-rate FDM on KK (claude/kk-fdm-stage1) with Codex's FDM observers.
# Custom resolve stays enabled. Extra game args go after --, e.g. +vr_fdm 1.
set -eu
base=${ALYX_NATIVE_ROOT:-"$HOME/Code/alyx-native"}
icd=${KK_ICD:-"$base/build/kk-fdm/src/kosmickrisp/vulkan/kosmickrisp_mesa_devenv_icd.aarch64.json"}
export MESA_KK_EXPERIMENTAL=${MESA_KK_EXPERIMENTAL:-fdm}
exec python3 "$base/with-matching-monado.py" \
 --build "$base/build/monado-kk-fd-guard" -- \
 "$base/run-alyx-foveation-trace" \
 --driver kosmickrisp \
 --icd "$icd" \
 --runtime-json "$base/build/monado-kk-fd-guard/openxr_monado-dev.json" \
 --extended-dynamic-state3 disabled --sample-locations-compat enabled \
 --api-trace "$@"
