#!/bin/sh
# Unattended desktop gameplay run: loads a1_intro_world_2 without the intro
# video and clicks the left controller trigger every 15 s from 45 s (the same
# as Left Ctrl + click in the qwerty window) to get past the start prompt.
#
# usage: run-alyx-desktop-game OUTPUT_DIR [TIMEOUT_S] [extra game args...]
# Set MESA_KK_EXPERIMENTAL, KK_* and KK_ICD in the environment as usual.
set -eu
base=${ALYX_NATIVE_ROOT:-"$HOME/Code/alyx-native"}
out=$1
timeout=${2:-300}
shift
[ $# -gt 0 ] && shift
tmp=${ALYX_GAME_TMPDIR:-"/private/tmp/claude-501/alyx-game-tmp"}
mkdir -p "$tmp"
export ALYX_GAME_TMPDIR="$tmp"
export QWERTY_SCRIPT=${QWERTY_SCRIPT:-"45+lctrl,45.1+left,45.6-left,45.7-lctrl"}
export QWERTY_SCRIPT_REPEAT=${QWERTY_SCRIPT_REPEAT:-15}
export KK_ICD=${KK_ICD:-"$base/build/kk-fdm/src/kosmickrisp/vulkan/kosmickrisp_mesa_devenv_icd.aarch64.json"}
exec "$base/kk-tests/run-alyx-kk-desktop" --output "$out" --timeout "$timeout" -- \
 -novid +vr_fidelity_level_auto 0 +vr_fidelity_level 5 +map a1_intro_world_2 "$@"
