#!/bin/sh
# Real headset, custom resolve enabled, KK FDM build (claude/kk-fdm-stage1).
# Set MESA_KK_EXPERIMENTAL=fdm or fdm,fdm_rate; KK_FDM_DEBUG=1 logs FDM passes.
# Adds +vr_symmetric_fov 0: native Alyx's symmetric-FOV frames are misplaced on
# the PSVR2's asymmetric FOV through xrizer (cut and misaligned eyes).
set -eu
# XRIZER_LIBRARY overrides the xrizer build (for example build/xrizer-gaze).
if [ -n "${XRIZER_LIBRARY:-}" ]; then set -- --xrizer-library "$XRIZER_LIBRARY" "$@"; fi
has_separator=0
for argument do
 [ "$argument" = -- ] && has_separator=1
done
if [ "$has_separator" = 0 ]; then set -- "$@" --; fi
set -- "$@" +vr_symmetric_fov 0
base=${ALYX_NATIVE_ROOT:-"$HOME/Code/alyx-native"}
icd=${KK_ICD:-"$base/build/kk-fdm/src/kosmickrisp/vulkan/kosmickrisp_mesa_devenv_icd.aarch64.json"}
exec python3 "$base/kk-tests/with-matching-monado-headset.py" --mode headset \
 --build "$base/build/monado-kk-fd-guard" -- \
 "$base/run-alyx-gpu-timing" \
 --driver kosmickrisp \
 --icd "$icd" \
 --runtime-json "$base/build/monado-kk-fd-guard/openxr_monado-dev.json" \
 --extended-dynamic-state3 disabled --sample-locations-compat enabled \
 --api-trace "$@"
