+{
+   const uint32_t *invocations = data;
+
+   switch (intrin->intrinsic) {
+   case nir_intrinsic_load_frag_size:
+      b->cursor = nir_before_instr(&intrin->instr);
+      nir_def_replace(&intrin->def,
