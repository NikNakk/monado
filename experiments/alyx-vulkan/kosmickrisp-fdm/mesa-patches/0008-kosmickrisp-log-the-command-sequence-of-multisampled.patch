+void
+kk_seq_log(struct kk_cmd_buffer *cmd, const char *fmt, ...)
+{
+   if (!cmd->state.gfx.seq_log)
+      return;
+   char buf[256];
+   va_list ap;
+   va_start(ap, fmt);
+   vsnprintf(buf, sizeof(buf), fmt, ap);
+   va_end(ap);
+   mesa_logi("kk-seq %p: %s", (void *)cmd, buf);
+}
