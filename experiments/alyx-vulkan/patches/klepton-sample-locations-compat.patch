From 23bcf0d4ae0095424ba08b7b7786f960e5844c4d Mon Sep 17 00:00:00 2001
From: Nick Kennedy <nick@nick-kennedy.com>
Date: Tue, 20 Oct 2026 09:15:08 +0200
Subject: [PATCH] vulkan: opt in to supported sample-location state for native
 Alyx

Signed-off-by: Nick Kennedy <nick@nick-kennedy.com>
---
 runtime/gfx/kl_vulkan.c                | 56 +++++++++++++++++--
 tests/t_vulkan_sample_locations.c      | 74 ++++++++++++++++++++++++++
 tools/check_vulkan_sample_locations.sh | 12 +++++
 tools/check_vulkan_strict.sh           |  2 +-
 4 files changed, 140 insertions(+), 4 deletions(-)
 create mode 100644 tests/t_vulkan_sample_locations.c
 create mode 100644 tools/check_vulkan_sample_locations.sh

diff --git a/runtime/gfx/kl_vulkan.c b/runtime/gfx/kl_vulkan.c
index 5def5b8..852bbd4 100644
--- a/runtime/gfx/kl_vulkan.c
+++ b/runtime/gfx/kl_vulkan.c
@@ -120,7 +120,9 @@ void *kl_vulkan_xr_image_mtl(unsigned long long img) { (void)img; return NULL; }
 #define KLVK_MAX_IMAGES 8
 
 // Opt-in: preserve graphics semantics; only synthetic desktop WSI and
-// Vulkan portability requirements are adapted at this boundary.
+// Vulkan portability requirements are adapted at this boundary. The separate
+// KL_VK_SAMPLE_LOCATIONS_COMPAT opt-in can enable one supported driver feature
+// for native Alyx; it never removes requested features or installs graphics stubs.
 static int strict_enabled;
 static pthread_once_t strict_once = PTHREAD_ONCE_INIT;
 static void strict_configure(void) { strict_enabled = kl_env_on("KL_VK_STRICT", 0); }
@@ -553,7 +555,7 @@ static int synthetic_wsi(const char *name) {
 static const char **strict_extensions(uint32_t n, const char *const *names,
                                       int instance, uint32_t *used, int *portability) {
     *used = 0; *portability = 0;
-    const char **result = calloc((size_t)n + 1, sizeof *result);
+    const char **result = calloc((size_t)n + 2, sizeof *result);
     if (!result) return NULL;
     for (uint32_t i = 0; i < n; ++i)
         if (!instance || !synthetic_wsi(names[i])) result[(*used)++] = names[i];
@@ -881,6 +883,51 @@ static void trace_device_request(const VkDeviceCreateInfo *ci) {
     }
 }
 
+// Explicit native-Alyx compatibility profile. Its state3-disable option still
+// emits vkCmdSetSampleLocationsEnableEXT. Enable the real supported feature so
+// that command resolves and executes in the driver. Never remove a request,
+// claim color-write-mask support, duplicate a feature struct or install a stub.
+static VkResult sample_locations_compat(VkPhysicalDevice phys, VkDeviceCreateInfo *copy,
+                                        const VkExtensionProperties *props, uint32_t count,
+                                        const char **names, uint32_t *n,
+                                        VkPhysicalDeviceExtendedDynamicState3FeaturesEXT *extra) {
+    if (!kl_env_on("KL_VK_SAMPLE_LOCATIONS_COMPAT", 0)) return VK_SUCCESS;
+    int sample_locations = 0, state3 = 0;
+    for (uint32_t i = 0; i < *n; i++) {
+        sample_locations |= !strcmp(names[i], "VK_EXT_sample_locations");
+        state3 |= !strcmp(names[i], "VK_EXT_extended_dynamic_state3");
+    }
+    if (!sample_locations) return VK_SUCCESS;
+    if (!ext_supported(props, count, "VK_EXT_extended_dynamic_state3"))
+        return VK_ERROR_EXTENSION_NOT_PRESENT;
+    PFN_vkGetPhysicalDeviceFeatures2 query = (PFN_vkGetPhysicalDeviceFeatures2)
+        real_gipa(g_instance, "vkGetPhysicalDeviceFeatures2");
+    if (!query) query = (PFN_vkGetPhysicalDeviceFeatures2)
+        real_gipa(g_instance, "vkGetPhysicalDeviceFeatures2KHR");
+    if (!query) return VK_ERROR_INITIALIZATION_FAILED;
+    VkPhysicalDeviceExtendedDynamicState3FeaturesEXT supported = {
+        .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTENDED_DYNAMIC_STATE_3_FEATURES_EXT };
+    VkPhysicalDeviceFeatures2 features = {
+        .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2, .pNext = &supported };
+    query(phys, &features);
+    if (!supported.extendedDynamicState3SampleLocationsEnable)
+        return VK_ERROR_FEATURE_NOT_PRESENT;
+    const VkPhysicalDeviceExtendedDynamicState3FeaturesEXT *existing = NULL;
+    for (const VkBaseInStructure *p = copy->pNext; p; p = p->pNext)
+        if (p->sType == supported.sType) existing = (const void *)p;
+    if (existing && !existing->extendedDynamicState3SampleLocationsEnable)
+        return VK_ERROR_FEATURE_NOT_PRESENT;
+    if (!state3) names[(*n)++] = "VK_EXT_extended_dynamic_state3";
+    if (!existing) {
+        *extra = (VkPhysicalDeviceExtendedDynamicState3FeaturesEXT) {
+            .sType = supported.sType, .pNext = (void *)copy->pNext,
+            .extendedDynamicState3SampleLocationsEnable = VK_TRUE };
+        copy->pNext = extra;
+    }
+    VKI("Alyx compatibility: enabled real extendedDynamicState3SampleLocationsEnable; caller features preserved\n");
+    return VK_SUCCESS;
+}
+
 static VkResult strict_device(VkPhysicalDevice phys, const VkDeviceCreateInfo *ci,
                               const VkAllocationCallbacks *alloc, VkDevice *out) {
     PFN_vkCreateDevice create = (PFN_vkCreateDevice)real_gipa(g_instance, "vkCreateDevice");
@@ -897,16 +944,19 @@ static VkResult strict_device(VkPhysicalDevice phys, const VkDeviceCreateInfo *c
     if (r == VK_SUCCESS && !portability && ext_supported(props, count, "VK_KHR_portability_subset"))
         names[n++] = "VK_KHR_portability_subset";
     VkDeviceCreateInfo copy = *ci;
+    VkPhysicalDeviceExtendedDynamicState3FeaturesEXT extra;
+    if (r == VK_SUCCESS) r = sample_locations_compat(phys, &copy, props, count, names, &n, &extra);
     copy.enabledExtensionCount = n; copy.ppEnabledExtensionNames = names;
     trace_extensions("strict-device-request", ci->enabledExtensionCount, ci->ppEnabledExtensionNames);
     trace_chain("strict-device-request", ci->pNext);
     trace_device_request(ci);
     trace_extensions("strict-device-forwarded", n, names);
+    trace_chain("strict-device-forwarded", copy.pNext);
     if (r == VK_SUCCESS) {
         r = create(phys, &copy, alloc, out);
         VKI("strict vkCreateDevice driver result=%d\n", (int)r);
     } else {
-        VKI("strict vkCreateDevice extension enumeration result=%d\n", (int)r);
+        VKI("strict vkCreateDevice preflight result=%d\n", (int)r);
     }
     free(props); free(names);
     // In particular: no FEATURE_NOT_PRESENT clamp/retry or mutation of caller pNext.
diff --git a/tests/t_vulkan_sample_locations.c b/tests/t_vulkan_sample_locations.c
new file mode 100644
index 0000000..cc794b2
--- /dev/null
+++ b/tests/t_vulkan_sample_locations.c
@@ -0,0 +1,74 @@
+// Copyright 2026, Nick Kennedy
+// SPDX-License-Identifier: MIT
+// Real-driver test for the explicit native Alyx sample-location profile.
+#define VK_NO_PROTOTYPES
+#include <vulkan/vulkan.h>
+#include <assert.h>
+#include <dlfcn.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+const char *kl_driver_target_name(void) { return "sample-locations-test"; }
+void kl_glfb_note_eye_mtl_texture(int a,int b,void *c,int d,int e,int f) { abort(); }
+int main(int argc,char **argv) {
+    assert(argc==3);int enabled=atoi(argv[2]);
+    void *library=dlopen(argv[1],RTLD_LAZY|RTLD_LOCAL);assert(library);
+    void *(*sym)(const char*)=dlsym(library,"kl_vulkan_sym");assert(sym);
+    PFN_vkGetInstanceProcAddr gipa=(void*)sym("vkGetInstanceProcAddr");
+    PFN_vkGetDeviceProcAddr gdpa=(void*)sym("vkGetDeviceProcAddr");
+    VkApplicationInfo app={.sType=VK_STRUCTURE_TYPE_APPLICATION_INFO,.apiVersion=VK_API_VERSION_1_2};
+    VkInstanceCreateInfo ic={.sType=VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO,.pApplicationInfo=&app};
+    VkInstance instance;
+    assert(((PFN_vkCreateInstance)gipa(0,"vkCreateInstance"))(&ic,0,&instance)==VK_SUCCESS);
+    uint32_t n=1;VkPhysicalDevice pd;
+    assert(((PFN_vkEnumeratePhysicalDevices)gipa(instance,"vkEnumeratePhysicalDevices"))(instance,&n,&pd)==VK_SUCCESS);
+    float priority=1;VkDeviceQueueCreateInfo queue={.sType=VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO,
+        .queueCount=1,.pQueuePriorities=&priority};
+    const char *extension="VK_EXT_sample_locations";
+    VkDeviceCreateInfo dc={.sType=VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO,.queueCreateInfoCount=1,
+        .pQueueCreateInfos=&queue,.enabledExtensionCount=1,.ppEnabledExtensionNames=&extension};
+    VkDeviceCreateInfo before=dc;VkDevice device;
+    PFN_vkCreateDevice create=(void*)gipa(instance,"vkCreateDevice");
+    assert(create(pd,&dc,0,&device)==VK_SUCCESS);
+    assert(!memcmp(&before,&dc,sizeof dc));
+    PFN_vkCmdSetSampleLocationsEnableEXT sample=(void*)gdpa(device,"vkCmdSetSampleLocationsEnableEXT");
+    printf("profile=%d native-command-available=%d\n",enabled,sample!=NULL);
+    assert((sample!=NULL)==enabled);
+    if(enabled) {
+        VkCommandPoolCreateInfo pc={.sType=VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+        VkCommandPool pool;
+        assert(((PFN_vkCreateCommandPool)gdpa(device,"vkCreateCommandPool"))(device,&pc,0,&pool)==VK_SUCCESS);
+        VkCommandBufferAllocateInfo ac={.sType=VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+            .commandPool=pool,.level=VK_COMMAND_BUFFER_LEVEL_PRIMARY,.commandBufferCount=1};
+        VkCommandBuffer command;
+        assert(((PFN_vkAllocateCommandBuffers)gdpa(device,"vkAllocateCommandBuffers"))(device,&ac,&command)==VK_SUCCESS);
+        VkCommandBufferBeginInfo bc={.sType=VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+        assert(((PFN_vkBeginCommandBuffer)gdpa(device,"vkBeginCommandBuffer"))(command,&bc)==VK_SUCCESS);
+        sample(command,VK_TRUE);sample(command,VK_FALSE);
+        assert(((PFN_vkEndCommandBuffer)gdpa(device,"vkEndCommandBuffer"))(command)==VK_SUCCESS);
+        VkQueue q;((PFN_vkGetDeviceQueue)gdpa(device,"vkGetDeviceQueue"))(device,0,0,&q);
+        VkSubmitInfo submit={.sType=VK_STRUCTURE_TYPE_SUBMIT_INFO,.commandBufferCount=1,.pCommandBuffers=&command};
+        assert(((PFN_vkQueueSubmit)gdpa(device,"vkQueueSubmit"))(q,1,&submit,VK_NULL_HANDLE)==VK_SUCCESS);
+        assert(((PFN_vkQueueWaitIdle)gdpa(device,"vkQueueWaitIdle"))(q)==VK_SUCCESS);
+        ((PFN_vkDestroyCommandPool)gdpa(device,"vkDestroyCommandPool"))(device,pool,0);
+        puts("PASS: native sample-location enable/disable commands record, submit and complete");
+    }
+    ((PFN_vkDestroyDevice)gdpa(device,"vkDestroyDevice"))(device,0);
+    if(enabled) {
+        VkPhysicalDeviceExtendedDynamicState3FeaturesEXT existing={
+            .sType=VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTENDED_DYNAMIC_STATE_3_FEATURES_EXT};
+        dc.pNext=&existing;
+        assert(create(pd,&dc,0,&device)==VK_ERROR_FEATURE_NOT_PRESENT);
+        assert(existing.pNext==NULL && !existing.extendedDynamicState3SampleLocationsEnable);
+        existing.extendedDynamicState3SampleLocationsEnable=VK_TRUE;
+        assert(create(pd,&dc,0,&device)==VK_SUCCESS);
+        assert(existing.pNext==NULL && existing.extendedDynamicState3SampleLocationsEnable);
+        ((PFN_vkDestroyDevice)gdpa(device,"vkDestroyDevice"))(device,0);
+        existing.extendedDynamicState3ColorWriteMask=VK_TRUE;
+        assert(create(pd,&dc,0,&device)==VK_ERROR_FEATURE_NOT_PRESENT);
+        assert(existing.extendedDynamicState3ColorWriteMask==VK_TRUE);
+        puts("PASS: existing feature chains preserved; unsupported color-write-mask requests still fail");
+    }
+    ((PFN_vkDestroyInstance)gipa(instance,"vkDestroyInstance"))(instance,0);
+    return 0;
+}
diff --git a/tools/check_vulkan_sample_locations.sh b/tools/check_vulkan_sample_locations.sh
new file mode 100644
index 0000000..31c126d
--- /dev/null
+++ b/tools/check_vulkan_sample_locations.sh
@@ -0,0 +1,12 @@
+#!/bin/sh
+# SPDX-License-Identifier: MIT
+set -eu
+cd "$(dirname "$0")/.."
+work=$(mktemp -d /private/tmp/klepton-sample-locations.XXXXXX)
+trap 'rm -rf "$work"' EXIT
+prefix=${VULKAN_SDK:-/opt/homebrew}
+clang -dynamiclib -O1 -I"$prefix/include" -Iruntime -Iruntime/gfx -Iruntime/guest \
+ runtime/gfx/kl_vulkan.c runtime/kl_env.c -Wl,-undefined,dynamic_lookup -lz -o "$work/libklvulkan.dylib"
+clang -I"$prefix/include" -Wl,-export_dynamic tests/t_vulkan_sample_locations.c -o "$work/test"
+KL_VK_STRICT=1 KL_VK_SAMPLE_LOCATIONS_COMPAT=0 "$work/test" "$work/libklvulkan.dylib" 0
+KL_VK_STRICT=1 KL_VK_SAMPLE_LOCATIONS_COMPAT=1 "$work/test" "$work/libklvulkan.dylib" 1
diff --git a/tools/check_vulkan_strict.sh b/tools/check_vulkan_strict.sh
index 7aed126..7c686e8 100644
--- a/tools/check_vulkan_strict.sh
+++ b/tools/check_vulkan_strict.sh
@@ -19,6 +19,6 @@ assert 'device-request core word=4 value=1' in s  # geometryShader
 assert 'VkPhysicalDeviceFragmentDensityMapFeaturesEXT payloadWord=0 value=1' in s
 assert 'VkPhysicalDeviceFragmentDensityMapFeaturesEXT payloadWord=1 value=1' in s
 assert 'strict vkCreateDevice driver result=-8' in s
-assert 'strict vkCreateDevice extension enumeration result=-3' in s
+assert 'strict vkCreateDevice preflight result=-3' in s
 print('PASS: exact feature payload and driver/enumeration failure diagnostics')
 CHECK
