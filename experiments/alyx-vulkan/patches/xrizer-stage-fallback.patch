From 2b73755fe49339f3ceafc9ac657de9ef3a097f59 Mon Sep 17 00:00:00 2001
From: Nick Kennedy <nick@nick-kennedy.com>
Date: Tue, 20 Oct 2026 14:46:27 +0200
Subject: [PATCH] Preserve stereo submissions when stage rendering is
 unsupported or fails

Signed-off-by: Nick Kennedy <nick@nick-kennedy.com>
---
 fakexr/src/lib.rs              | 27 ++++++++++++++-
 src/compositor.rs              | 60 ++++++++++++++++++++++++++++++++++
 src/graphics_backends.rs       |  5 +++
 src/graphics_backends/d3d11.rs |  4 +++
 4 files changed, 95 insertions(+), 1 deletion(-)

diff --git a/fakexr/src/lib.rs b/fakexr/src/lib.rs
index 3021e72..60c09b8 100644
--- a/fakexr/src/lib.rs
+++ b/fakexr/src/lib.rs
@@ -306,7 +306,7 @@ pub unsafe extern "system" fn get_instance_proc_addr(
                     (EnumerateViewConfigurations),
                     (EnumerateEnvironmentBlendModes),
                     (GetViewConfigurationProperties),
-                    (EnumerateViewConfigurationViews),
+                    EnumerateViewConfigurationViews,
                     BeginFrame,
                     EndFrame,
                     WaitFrame,
@@ -1863,3 +1863,28 @@ extern "system" fn apply_haptic_feedback(
 
     xr::Result::SUCCESS
 }
+
+// Stereo stage-fallback regression: deliberately differs from app swapchain size.
+extern "system" fn enumerate_view_configuration_views(
+    _instance: xr::Instance, _system: xr::SystemId, kind: xr::ViewConfigurationType,
+    capacity: u32, count: *mut u32, views: *mut xr::ViewConfigurationView,
+) -> xr::Result {
+    if kind != xr::ViewConfigurationType::PRIMARY_STEREO {
+        return xr::Result::ERROR_VIEW_CONFIGURATION_TYPE_UNSUPPORTED;
+    }
+    unsafe { count.write(2); }
+    if capacity==0 { return xr::Result::SUCCESS; }
+    if capacity<2 { return xr::Result::ERROR_SIZE_INSUFFICIENT; }
+    for i in 0..2 {
+        unsafe {
+            let view=&mut *views.add(i);
+            view.recommended_image_rect_width=100;
+            view.recommended_image_rect_height=100;
+            view.max_image_rect_width=100;
+            view.max_image_rect_height=100;
+            view.recommended_swapchain_sample_count=1;
+            view.max_swapchain_sample_count=1;
+        }
+    }
+    xr::Result::SUCCESS
+}
