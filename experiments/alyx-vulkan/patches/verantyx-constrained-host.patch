diff --git a/NativeARM/host/kl_lua_builtin.c b/NativeARM/host/kl_lua_builtin.c
new file mode 100644
index 0000000..060aa55
--- /dev/null
+++ b/NativeARM/host/kl_lua_builtin.c
@@ -0,0 +1,26 @@
+// SPDX-License-Identifier: BSL-1.0
+// Copyright 2026, Nick Kennedy
+// No instruction scanning, executable-page writes or allocation-size overrides.
+#include <stdio.h>
+#include <stdlib.h>
+#include "klepton.h"
+#include "kl_lua_builtin.h"
+
+typedef void (*mmap_setter)(void *, void *, void *, void *, void *);
+static void select_builtin(void *prepare, void *reserve, void *resize,
+                           void *release, void *extra) {
+    (void)prepare; (void)reserve; (void)resize; (void)release; (void)extra;
+    kl_image *image = kl_find_image("libvscript.so");
+    // kl_sym returns the image's definition, bypassing the interpose registry.
+    mmap_setter original = image ? (mmap_setter)kl_sym(image, "lua_VALVE_OVERRIDE_MMAP") : NULL;
+    if (!original || original == select_builtin) {
+        fprintf(stderr, "[lua-builtin] original setter unavailable; refusing to continue\n");
+        abort();
+    }
+    original(NULL, NULL, NULL, NULL, NULL);
+    fprintf(stderr, "[lua-builtin] selected built-in mmap allocator (game lifecycle unvalidated)\n");
+}
+
+void kl_lua_builtin_install(void) {
+    kl_interpose("lua_VALVE_OVERRIDE_MMAP", (void *)select_builtin);
+}
