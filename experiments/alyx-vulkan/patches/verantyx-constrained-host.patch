diff --git a/NativeARM/host/kl_thread_probe.c b/NativeARM/host/kl_thread_probe.c
new file mode 100644
index 0000000..7b914cc
--- /dev/null
+++ b/NativeARM/host/kl_thread_probe.c
@@ -0,0 +1,20 @@
+// SPDX-License-Identifier: BSL-1.0
+// Copyright 2026, Nick Kennedy
+#include <errno.h>
+#include <stdint.h>
+#include <unistd.h>
+#include <libproc.h>
+#include <sys/proc_info.h>
+#include "kl_thread_probe.h"
+
+// Klepton exposes pthread_threadid_np IDs as guest gettid values. Probe only
+// this process. A cached kernel thread may outlive pthread_join; this is NOT
+// sufficient for Linux guest thread-exit semantics. Never translate these IDs into pthread_t or send a real signal.
+long kl_thread_probe(long tid) {
+    struct proc_threadinfo info;
+    if (tid > 0 && proc_pidinfo(getpid(), PROC_PIDTHREADID64INFO,
+                              (uint64_t)tid, &info, sizeof info) == sizeof info)
+        return 0;
+    errno = ESRCH;
+    return -1;
+}
