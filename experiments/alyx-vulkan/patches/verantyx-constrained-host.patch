diff --git a/NativeARM/host/tests/check_constrained.py b/NativeARM/host/tests/check_constrained.py
new file mode 100644
index 0000000..725e217
--- /dev/null
+++ b/NativeARM/host/tests/check_constrained.py
@@ -0,0 +1,24 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: BSL-1.0
+# Copyright 2026, Nick Kennedy
+"""Only launches host preflight; all guest paths deliberately nonexistent."""
+import pathlib
+import subprocess
+import sys
+
+host = pathlib.Path(sys.argv[1]).resolve()
+check = subprocess.run([str(host), '--constrained-check'], capture_output=True, text=True)
+assert check.returncode == 0 and 'guest execution disabled' in check.stdout, check
+for args in (
+    ['--libdir', '/nonexistent-alyx', '--probe', 'libvscript.so'],
+    ['--libdir', '/nonexistent-alyx', '--game', '/nonexistent-alyx'],
+    ['--constrained-check', '--probe', 'libvscript.so'],
+):
+    result = subprocess.run([str(host), *args], capture_output=True, text=True)
+    assert result.returncode == 2, result
+    assert 'Source2Main' not in result.stderr and 'loaded with dependencies' not in result.stdout
+symbols = subprocess.check_output(['nm', str(host)], text=True)
+for symbol in ('_kl_luafix_install', '_kl_guestfix_install'):
+    assert symbol not in symbols, symbol
+assert '_kl_lua_builtin_install' in symbols
+print('PASS: constrained preflight, probe/game rejection and excluded patch symbols')
diff --git a/NativeARM/host/tests/lua_builtin.c b/NativeARM/host/tests/lua_builtin.c
new file mode 100644
index 0000000..3d0375e
--- /dev/null
+++ b/NativeARM/host/tests/lua_builtin.c
@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: BSL-1.0
+// Copyright 2026, Nick Kennedy
+// Host-owned fixture only: never loads or executes Valve code.
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#include <signal.h>
+#include <sys/resource.h>
+#include "klepton.h"
+#include "kl_lua_builtin.h"
+static void (*bound)(void *, void *, void *, void *, void *);
+static int calls, missing;
+static void setter(void *a, void *b, void *c, void *d, void *e) {
+    assert(!a && !b && !c && !d && !e); calls++;
+}
+void kl_interpose(const char *name, void *fn) {
+    assert(!strcmp(name, "lua_VALVE_OVERRIDE_MMAP")); bound = fn;
+}
+kl_image *kl_find_image(const char *name) {
+    assert(!strcmp(name, "libvscript.so"));
+    return missing == 1 ? NULL : (kl_image *)&calls;
+}
+void *kl_sym(kl_image *image, const char *name) {
+    assert(image == (kl_image *)&calls);
+    assert(!strcmp(name, "lua_VALVE_OVERRIDE_MMAP"));
+    return missing == 2 ? NULL : missing == 3 ? (void *)bound : (void *)setter;
+}
+int main(void) {
+    struct rlimit no_core = {0, 0}; setrlimit(RLIMIT_CORE, &no_core);
+    kl_lua_builtin_install(); assert(bound);
+    for (int i = 0; i < 2; ++i) bound(&calls, &calls, &calls, &calls, &calls);
+    assert(calls == 2);
+    for (missing = 1; missing <= 3; ++missing) {
+        pid_t pid = fork(); assert(pid >= 0);
+        if (!pid) { bound(NULL, NULL, NULL, NULL, NULL); _exit(1); }
+        int status; assert(waitpid(pid, &status, 0) == pid);
+        assert(WIFSIGNALED(status) && WTERMSIG(status) == SIGABRT);
+    }
+    puts("PASS: callback substitution, repeated binding, missing image/symbol and recursion fail closed");
+}
diff --git a/NativeARM/host/tests/thread_probe.c b/NativeARM/host/tests/thread_probe.c
new file mode 100644
index 0000000..5024b90
--- /dev/null
+++ b/NativeARM/host/tests/thread_probe.c
@@ -0,0 +1,56 @@
+// SPDX-License-Identifier: BSL-1.0
+// Copyright 2026, Nick Kennedy
+#include <assert.h>
+#include <errno.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <mach/mach.h>
+#include <sys/resource.h>
+#include <sched.h>
+#include "kl_thread_probe.h"
+static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t cond = PTHREAD_COND_INITIALIZER;
+static int ready, finish;
+static uint64_t worker_id;
+static void *worker(void *arg) {
+    pthread_mutex_lock(&lock);
+    assert(!pthread_threadid_np(NULL, &worker_id));
+    ready = 1; pthread_cond_signal(&cond);
+    while (!finish) pthread_cond_wait(&cond, &lock);
+    pthread_mutex_unlock(&lock);
+    return NULL;
+}
+int main(void) {
+    struct rlimit no_core = {0, 0}; setrlimit(RLIMIT_CORE, &no_core);
+    uint64_t self; assert(!pthread_threadid_np(NULL, &self));
+    assert(kl_thread_probe(self) == 0);
+    pthread_t thread; assert(!pthread_create(&thread, NULL, worker, NULL));
+    pthread_mutex_lock(&lock);
+    while (!ready) pthread_cond_wait(&cond, &lock);
+    assert(kl_thread_probe(worker_id) == 0);
+    finish = 1; pthread_cond_signal(&cond); pthread_mutex_unlock(&lock);
+    assert(!pthread_join(thread, NULL));
+    long joined = kl_thread_probe(worker_id);
+    printf("joined pthread kernel probe: %ld (0 means retained kernel thread; guest exit tracking still needed)\n", joined);
+    // An actually terminated Mach thread, unlike a cached pthread worker.
+    thread_act_t suspended;
+    assert(thread_create(mach_task_self(), &suspended) == KERN_SUCCESS);
+    thread_identifier_info_data_t ident;
+    mach_msg_type_number_t count = THREAD_IDENTIFIER_INFO_COUNT;
+    assert(thread_info(suspended, THREAD_IDENTIFIER_INFO, (thread_info_t)&ident, &count) == KERN_SUCCESS);
+    assert(kl_thread_probe(ident.thread_id) == 0);
+    assert(thread_terminate(suspended) == KERN_SUCCESS);
+    long dead = 0;
+    for (int i = 0; i < 1000; ++i) {
+        dead = kl_thread_probe(ident.thread_id);
+        if (dead == -1) break;
+        sched_yield();
+    }
+    assert(dead == -1 && errno == ESRCH);
+    // Termination may invalidate the port name before this cleanup.
+    (void)mach_port_deallocate(mach_task_self(), suspended);
+    errno = 0; assert(kl_thread_probe(0) == -1 && errno == ESRCH);
+    errno = 0; assert(kl_thread_probe(-1) == -1 && errno == ESRCH);
+    puts("PASS: kernel current/live/terminated/invalid probes; guest pthread-exit semantics remain unverified");
+}
