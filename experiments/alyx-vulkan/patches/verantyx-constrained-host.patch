diff --git a/NativeARM/host/Makefile b/NativeARM/host/Makefile
index 3479d81..7fad4ca 100644
--- a/NativeARM/host/Makefile
+++ b/NativeARM/host/Makefile
@@ -21,7 +21,15 @@ LDLIBS := -lz -lresolv -liconv -framework AudioToolbox -framework CoreAudio \
           -framework CoreFoundation -framework AVFoundation -framework Foundation
 
 RT_OBJS   := $(patsubst %,$(OUT)/kl/%.o,$(RUNTIME))
-HOST_SRCS := alyx_host.c kl_glibc.c kl_glibc_va.S kl_enginelog.c kl_sdlshim.c kl_steambridge.c kl_luafix.c kl_sdlaudio.c kl_guestfix.c
+HOST_SRCS := alyx_host.c kl_thread_probe.c kl_glibc.c kl_glibc_va.S kl_enginelog.c kl_sdlshim.c kl_steambridge.c kl_luafix.c kl_sdlaudio.c kl_guestfix.c
+# Separate output directories are required when changing HOST_MODE.
+HOST_MODE ?= legacy
+ifeq ($(HOST_MODE),constrained)
+CFLAGS += -DALYX_CONSTRAINED_HOST=1
+HOST_SRCS := $(filter-out kl_luafix.c kl_guestfix.c,$(HOST_SRCS)) kl_lua_builtin.c
+else ifneq ($(HOST_MODE),legacy)
+$(error HOST_MODE must be legacy or constrained)
+endif
 HOST_OBJS := $(patsubst %,$(OUT)/%.o,$(HOST_SRCS))
 # The OpenVR runtime (C++): ../vrruntime.
 VRRT_DIR  := ../vrruntime
@@ -67,3 +75,29 @@ clean:
 	rm -rf $(OUT)
 
 .PHONY: all probe clean
+
+# Native fixture: no guest loading or Steam dependency.
+check-lua-builtin:
+	@mkdir -p $(OUT)
+	$(CC) $(CFLAGS) -o $(OUT)/check-lua-builtin tests/lua_builtin.c kl_lua_builtin.c -I.
+	$(OUT)/check-lua-builtin
+
+.PHONY: check-lua-builtin
+
+check-thread-probe:
+	@mkdir -p $(OUT)
+	$(CC) $(CFLAGS) -o $(OUT)/check-thread-probe tests/thread_probe.c kl_thread_probe.c -I.
+	$(OUT)/check-thread-probe
+
+.PHONY: check-thread-probe
+
+# Avoid silently reusing objects compiled for the other mode.
+check-host-mode:
+	@mkdir -p $(OUT)
+	@if test -f $(OUT)/.host-mode && test "$$(cat $(OUT)/.host-mode)" != "$(HOST_MODE)"; then \
+	  echo "Use a separate OUT directory for HOST_MODE=$(HOST_MODE)" >&2; exit 2; \
+	fi
+	@echo $(HOST_MODE) > $(OUT)/.host-mode
+
+$(RT_OBJS) $(HOST_OBJS) $(VRRT_OBJS): | check-host-mode
+.PHONY: check-host-mode
diff --git a/NativeARM/host/XRIZER.md b/NativeARM/host/XRIZER.md
index 6bac002..2d938db 100644
--- a/NativeARM/host/XRIZER.md
+++ b/NativeARM/host/XRIZER.md
@@ -26,3 +26,50 @@ repairs (including LuaJIT and video fixes). A no-game-binary-modification policy
 therefore blocks using this host as-is: audit/replace these mechanisms first.
 Steam authentication must still go through the owner's signed-in macOS Steam.
 No launcher, global registry, Steam account or game content was changed here.
+
+## Constrained host scaffold (20 October 2026)
+
+This opt-in build excludes `kl_luafix.c` and `kl_guestfix.c`. The replacement
+interposes `lua_VALVE_OVERRIDE_MMAP` and passes five null callbacks to the
+image's original setter, selecting Valve Lua's built-in mmap fallback. It
+performs no executable-page writes. Native fixtures test setter binding,
+repeat calls and refusal on a missing image/symbol or recursive binding.
+**They do not execute Valve Lua or validate its allocation lifecycle.**
+
+```sh
+make -C NativeARM/host KL=/private/tmp/alyx-klepton \
+  OUT=/private/tmp/alyx-constrained-host-build VR_RUNTIME=xrizer \
+  HOST_MODE=constrained -j6
+make -C NativeARM/host KL=/private/tmp/alyx-klepton \
+  OUT=/private/tmp/alyx-constrained-host-build VR_RUNTIME=xrizer \
+  HOST_MODE=constrained check-lua-builtin check-thread-probe
+/private/tmp/alyx-constrained-host-build/alyx_host --constrained-check
+python3 NativeARM/host/tests/check_constrained.py \
+  /private/tmp/alyx-constrained-host-build/alyx_host
+```
+
+Use a separate output directory per mode. A `.host-mode` marker rejects mode
+changes once written. `legacy` remains the default. Do not reuse an old output
+directory with no marker when first switching modes; create a new one.
+
+**This is a preflight scaffold, not a runnable constrained game host.** It
+returns status 2 for both `--probe` and `--game` before guest loading or runtime
+setup. No environment variable bypasses the gate. The linked Klepton runtime
+still contains its generic patch table, raw-SVC rewrites and Vulkan semantic
+substitutions; these are unreachable through the scaffold. A future runnable
+mode must explicitly disable/replace them, rather than just removing this gate.
+The legacy build retains its existing behaviour and must not be used as a
+substitute for this audit.
+
+The native thread probe fixture exposed an additional limitation: a joined
+pthread's kernel thread may be retained by macOS, and `proc_pidinfo` still
+reports it alive. Factoring this query into `kl_thread_probe` allows testing
+current/live/terminated Mach thread IDs, but **does not implement Linux guest
+thread-exit semantics**. Correct lifecycle tracking must include guest thread
+creation, return and explicit exit; cross-process `tgkill` and signal errno
+handling also need review. The video patch cannot be declared unnecessary on
+the strength of the existing kernel query.
+
+Still unverified: Valve Lua mmap/mremap growth, shrink, allocation failure,
+47-bit addressing and teardown; page-size handling outside Lua; guest syscall
+translation and actual Alyx/OpenVR/Vulkan calls. No game was launched here.
