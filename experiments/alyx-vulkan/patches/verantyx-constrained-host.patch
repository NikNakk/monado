         else { fprintf(stderr, "unknown option %s\n", argv[i]); return 2; }
     }
+#ifdef ALYX_CONSTRAINED_HOST
+    // Both --probe and gameplay execute guest constructors. Until the loader's
+    // raw-SVC rewriting and Vulkan semantic substitutions are resolved, refuse
+    // both before any guest image, registry, cache or runtime is touched.
+    fprintf(stderr, "constrained host: guest execution blocked pending raw-SVC/ABI and Vulkan semantic audit\n");
+    return 2;
+#endif
     // The engine's console output goes through the guest's printf to our stdout
     // and the process ends with _exit(); unbuffered, nothing is lost.
     setvbuf(stdout, NULL, _IONBF, 0);
@@ -186,9 +203,15 @@ int main(int argc, char **argv) {
 
     kl_enginelog_install();        // the engine's console, to stderr
     kl_sdlshim_install();          // SDL window without X11; Vulkan surface from the shim
+#ifndef ALYX_CONSTRAINED_HOST
     kl_guestfix_install();         // byte-checked repairs of guest code at load
+#endif
     kl_sdlaudio_install();         // SDL2 audio -> Core Audio (Linux SDL has no macOS backend)
-    kl_luafix_install();           // LuaJIT arena above 4 GB (no low memory on arm64 macOS)
+#ifdef ALYX_CONSTRAINED_HOST
+    kl_lua_builtin_install();      // exported allocator setter; no text patch
+#else
+    kl_luafix_install();           // legacy Lua arena workaround
+#endif
     install_vr_path_registry();
     kl_steambridge_install();      // steam_api -> the macOS Steam client
     // fontconfig wants a writable cache; keep it beside the game root.
diff --git a/NativeARM/host/kl_glibc.c b/NativeARM/host/kl_glibc.c
index 1ce350f..74a9c65 100644
--- a/NativeARM/host/kl_glibc.c
+++ b/NativeARM/host/kl_glibc.c
@@ -1,3 +1,4 @@
+#include "kl_thread_probe.h"
 // glibc symbol layer for Klepton.
 //
 // Klepton's shim translates bionic (Android libc) names to Darwin. Valve's
@@ -323,9 +324,7 @@ long klgh_syscall(long nr, kl_va *va) {
     case 131: case 130: {
         long tid = nr == 131 ? a[1] : a[0], sig = nr == 131 ? a[2] : a[1];
         if (sig == 0) {
