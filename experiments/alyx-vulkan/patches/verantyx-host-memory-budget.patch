From 74396b5410a8b07f46d5759a041b45cc1180c85b Mon Sep 17 00:00:00 2001
From: Nick Kennedy <nick@nick-kennedy.com>
Date: Tue, 20 Oct 2026 11:31:12 +0200
Subject: [PATCH] Report host RAM for native Alyx launches

Signed-off-by: Nick Kennedy <nick@nick-kennedy.com>
---
 NativeARM/scripts/launch_xrizer.py      | 25 ++++++++++++++++++++++++-
 NativeARM/scripts/test_launch_xrizer.py | 11 ++++++++++-
 2 files changed, 34 insertions(+), 2 deletions(-)

diff --git a/NativeARM/scripts/launch_xrizer.py b/NativeARM/scripts/launch_xrizer.py
index a3173e0..851a8ca 100644
--- a/NativeARM/scripts/launch_xrizer.py
+++ b/NativeARM/scripts/launch_xrizer.py
@@ -31,6 +31,13 @@ parser.add_argument('--sample-locations-compat', choices=['auto','enabled','disa
 runtime=parser.add_mutually_exclusive_group(required=True)
 runtime.add_argument('--runtime-json',type=Path)
 runtime.add_argument('--no-xr-runtime',action='store_true')
+def positive_memory(value):
+    number=int(value)
+    if not 0<number<=2147483647:
+        raise argparse.ArgumentTypeError('memory MiB must be between 1 and 2147483647')
+    return number
+parser.add_argument('--memory-mb',type=positive_memory,
+                    help='guest RAM budget in MiB; default is host physical RAM (runtime caps overrides to host RAM)')
 parser.add_argument('--timeout',type=int,default=120)
 parser.add_argument('--dry-run',action='store_true')
 parser.add_argument('engine_args',nargs=argparse.REMAINDER)
@@ -57,6 +64,21 @@ elif 'XDG_CACHE_HOME' in os.environ:
     native_runtime_dir=os.environ['XDG_CACHE_HOME']+'/monado'
 else:
     native_runtime_dir=str(Path.home()/'Library/Caches/monado')
+# Klepton's default 6GiB identity targets Android games. Native Alyx should
+# discover this Mac's memory instead. Keep the runtime's host cap and actual
+# process-footprint/pressure accounting; this only selects its existing budget.
+if args.memory_mb is None:
+    try:
+        physical_bytes=int(subprocess.check_output(
+            ['/usr/sbin/sysctl','-n','hw.memsize'],text=True,stderr=subprocess.PIPE).strip())
+        if physical_bytes<1048576:raise ValueError('invalid host RAM')
+        memory_mb=physical_bytes//1048576
+    except (OSError,ValueError,subprocess.CalledProcessError) as error:
+        parser.error('cannot read host RAM; supply --memory-mb explicitly: '+str(error))
+    memory_source='hw.memsize'
+else:
+    memory_mb=args.memory_mb
+    memory_source='explicit'
 settings={
  'XDG_RUNTIME_DIR':native_runtime_dir,
  'VERANTYX_GUEST_HOME':str(args.output/'state/guest-home'),
@@ -70,6 +92,7 @@ settings={
  'FONTCONFIG_FILE':str(args.output/'config/fonts.conf'),
  'FONTCONFIG_PATH':str(args.output/'config'),
  'KL_VK_FOVEATION_TRACE':'1',
+ 'KL_MEM_TOTAL_MB':str(memory_mb),
  'ALYX_RESULT_FILE':str(args.output/'engine-result.log'),
 }
 command=['python3',str(backend),'--driver',args.driver,'--output',str(args.output/'backend')]
@@ -89,7 +112,7 @@ if args.runtime_json:
     library=Path(data['runtime']['library_path'])
     if not library.is_absolute():library=args.runtime_json.parent/library
     binaries['monado_runtime']=library.resolve(strict=True)
-manifest={'command':command,'environment':settings,'timeout':args.timeout,'headless':args.no_xr_runtime,
+manifest={'guest_memory_mb_requested':memory_mb,'guest_memory_source':memory_source,'command':command,'environment':settings,'timeout':args.timeout,'headless':args.no_xr_runtime,
           'extended_dynamic_state3_disabled':disable_state3,
           'sample_locations_compat':sample_compat,
           'binaries':{name:{'path':str(path),'sha256':hashlib.sha256(path.read_bytes()).hexdigest()} for name,path in binaries.items()}}
diff --git a/NativeARM/scripts/test_launch_xrizer.py b/NativeARM/scripts/test_launch_xrizer.py
index e86e5a6..ec9bd55 100644
--- a/NativeARM/scripts/test_launch_xrizer.py
+++ b/NativeARM/scripts/test_launch_xrizer.py
@@ -44,9 +44,13 @@ class NativeRuntimeDirectoryTest(unittest.TestCase):
                     command = [sys.executable, str(Path(__file__).with_name('launch_xrizer.py')),
                                '--root', str(game), '--libs', str(libs), '--xrizer', str(xrizer),
                                '--host', str(root / 'host'), '--openxr-loader', str(root / 'loader'),
-                               '--output', str(output), '--no-xr-runtime', '--dry-run']
+                               '--output', str(output), '--no-xr-runtime', '--dry-run',
+                               '--memory-mb','16384']
                     run = subprocess.run(command, env=env, capture_output=True, text=True, check=True)
                     settings = json.loads(run.stdout)['environment']
+                    self.assertEqual(settings['KL_MEM_TOTAL_MB'],'16384')
+                    self.assertEqual(json.loads(run.stdout)['guest_memory_mb_requested'],16384)
+                    self.assertEqual(json.loads(run.stdout)['guest_memory_source'],'explicit')
                     self.assertEqual(settings['XDG_RUNTIME_DIR'], str(expected))
                     self.assertEqual(settings['XDG_CACHE_HOME'], str(output / 'cache'))
                     self.assertEqual(settings['XDG_CONFIG_HOME'], str(output / 'config'))
@@ -58,6 +62,11 @@ class NativeRuntimeDirectoryTest(unittest.TestCase):
                     self.assertTrue(manifest['sample_locations_compat'])
                     self.assertEqual(settings['KL_VK_SAMPLE_LOCATIONS_COMPAT'],'1')
                     self.assertIn('-vulkan_disable_ext_dynamic_state_3',manifest['command'])
+                    for bad_memory in ['0','-1','2147483648']:
+                        bad=subprocess.run(command+['--memory-mb',bad_memory],env=env,
+                                           capture_output=True,text=True)
+                        self.assertEqual(bad.returncode,2)
+                        self.assertFalse(output.exists())
                     for driver, policy, disabled in [('moltenvk','enabled',False),
                                                       ('kosmickrisp','auto',False),
                                                       ('kosmickrisp','disabled',True)]:
-- 
