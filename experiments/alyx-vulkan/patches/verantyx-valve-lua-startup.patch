--- /dev/null
+++ b/NativeARM/host/tests/valve_lua.c
@@ -0,0 +1,137 @@
+// SPDX-License-Identifier: BSL-1.0
+// Copyright 2026, Nick Kennedy
+// Explicitly invoked, headless test of the owner's Valve Lua shared library.
+// No engine entry point, OpenVR, Steam bridge or game-specific text repair.
+#include "klepton.h"
+#include "kl_glibc.h"
+#include "kl_lua_builtin.h"
+#include "kl_fault.h"
+#include <assert.h>
+#include <errno.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/resource.h>
+#include <unistd.h>
+extern void *kl_shim_lookup(const char *);
+static void *(*real_mmap)(void *,size_t,int,int,int,long);
+static int (*real_munmap)(void *,size_t);
+static void *(*real_remap)(void *,size_t,size_t,int,void *);
+static size_t maps, unmaps, remaps, failures;
+static int refuse_mapping, track;
+static size_t live_bytes, peak_bytes;
+static struct {void *address;size_t size;} allocations[1024];
+static void *watch_mmap(void *a,size_t n,int prot,int flags,int fd,long off) {
+    if (refuse_mapping && (flags & 0x20)) { failures++; errno=ENOMEM; return MAP_FAILED; }
+    void *p=real_mmap(a,n,prot,flags,fd,off);
+    if(p!=MAP_FAILED) {
+        maps++;
+        if(track) {
+            size_t i=0;while(i<1024 && allocations[i].address)i++;assert(i<1024);
+            allocations[i].address=p;allocations[i].size=n;
+            live_bytes+=n;if(live_bytes>peak_bytes)peak_bytes=live_bytes;
+        }
+        if(maps<=16) fprintf(stderr,"[lua-map] allocate bytes=%zu address=%p prot=%d flags=%#x\n",n,p,prot,flags);
+        assert(((uintptr_t)p>>47)==0);
+    } else failures++;
+    return p;
+}
+static int watch_unmap(void *a,size_t n) {
+    int r=real_munmap(a,n);
+    if(unmaps<16) fprintf(stderr,"[lua-map] release bytes=%zu address=%p result=%d\n",n,a,r);
+    if(!r) {
+        unmaps++;
+        if(track) {
+            size_t i=0;while(i<1024 && allocations[i].address!=a)i++;assert(i<1024);
+            assert(allocations[i].size==n);live_bytes-=n;allocations[i].address=NULL;
+        }
+    }
+    return r;
+}
+static void *watch_remap(void *a,size_t old,size_t n,int flags,void *next) {
+    remaps++;
+    void *result=real_remap(a,old,n,flags,next);
+    assert(result==MAP_FAILED && errno==ENOSYS);
+    return result;
+}
+static void safety(const char *path,kl_image *img) {
+    const char *b=strrchr(path,'/');b=b?b+1:path;
+    assert(!strcmp(b,"libtier0.so")||!strcmp(b,"libvstdlib.so")||!strcmp(b,"libvscript.so")||!strcmp(b,"libstdc++.so.6")||!strcmp(b,"libgcc_s.so.1"));
+    const kl_stats *s=kl_get_stats(img);
+    unsigned n=0;const char *const *missing=kl_missing_imports(img,&n);
+    fprintf(stderr,"[lua-image] %s TLS=%u x18=%u CTR=%u SVC=%u missing=%u refused=%u/%u/%u\n",
+        b,s->tls_rewrites,s->x18_patched,s->ctr_patched,s->svc_sites,n,s->tls_refused,s->x18_refused,s->ctr_refused);
+    for(unsigned i=0;i<n;i++)fprintf(stderr,"[lua-missing] %s\n",missing[i]);
+    if(n||s->svc_sites||s->tls_refused||s->x18_refused||s->ctr_refused) {
+        fprintf(stderr,"[lua-test] unsafe image refused before constructors\n");exit(3);
+    }
+}
+int main(int argc,char **argv) {
+    if(argc!=5) {fprintf(stderr,"usage: %s LIBDIR SETTER_GOT_VA RANGE_BRANCH_VA RANGE_BRANCH_WORD\n",argv[0]);return 2;}
+    setvbuf(stdout,NULL,_IONBF,0);setvbuf(stderr,NULL,_IONBF,0);
+    struct rlimit no_core={0,0};setrlimit(RLIMIT_CORE,&no_core);
+    setenv("KL_GUEST_PATCH","0",1);setenv("KL_SVC_POLICY","reject-code",1);
+    setenv("KL_VK_STRICT","1",1);setenv("KL_GUEST_THREAD_TRACKING","1",1);
+    setenv("KL_TLS_REWRITE_FORCE","1",1);
+    unsetenv("KL_DYLIB_DIR");
+    kl_glibc_install(argv[0]);kl_set_library_path(argv[1]);kl_thread_init();kl_fault_install();
+    double (*floor_fn)(double)=kl_shim_lookup("floor");
+    assert(floor_fn && floor_fn(-1.25)==-2.0 && floor_fn(1.75)==1.0);
+    real_mmap=kl_shim_lookup("mmap64");real_munmap=kl_shim_lookup("munmap");real_remap=kl_shim_lookup("mremap");
+    assert(real_mmap&&real_munmap&&real_remap);
+    kl_interpose("mmap",watch_mmap);kl_interpose("mmap64",watch_mmap);
+    kl_interpose("munmap",watch_unmap);kl_interpose("mremap",watch_remap);
+    kl_lua_builtin_install();kl_image_loaded_hook=safety;
+    char path[4096];snprintf(path,sizeof path,"%s/libvscript.so",argv[1]);
+    kl_image *image=kl_load_recursive(path);
+    if(!image) {fprintf(stderr,"[lua-test] load failed: %s\n",kl_error());return 3;}
+    void (*setter)(void*,void*,void*,void*,void*)=kl_interpose_lookup("lua_VALVE_OVERRIDE_MMAP");
+    uintptr_t got=strtoull(argv[2],NULL,0),branch=strtoull(argv[3],NULL,0);
+    uint32_t expected=(uint32_t)strtoul(argv[4],NULL,0);
+    assert(got+sizeof(void*)<=kl_span(image) && branch+4<=kl_span(image));
+    assert(*(void**)((char*)kl_base(image)+got)==(void*)setter);
+    assert(*(uint32_t*)((char*)kl_base(image)+branch)==expected);
+    puts("PASS Lua real ELF setter relocation binding; original Lua range branch unchanged");
+    setter(NULL,NULL,NULL,NULL,NULL);
+    void *(*newstate)(void)=kl_sym(image,"luaL_newstate");
+    void (*close_state)(void*)=kl_sym(image,"lua_close");
+    void (*push)(void*,const char*,size_t)=kl_sym(image,"lua_pushlstring");
+    void (*settop)(void*,int)=kl_sym(image,"lua_settop");
+    const char *(*tostring)(void*,int,size_t*)=kl_sym(image,"lua_tolstring");
+    int (*gc)(void*,int,int)=kl_sym(image,"lua_gc");
+    void (*table)(void*,int,int)=kl_sym(image,"lua_createtable");
+    void (*pushint)(void*,intptr_t)=kl_sym(image,"lua_pushinteger");
+    void (*rawset)(void*,int,int)=kl_sym(image,"lua_rawseti");
+    void (*rawget)(void*,int,int)=kl_sym(image,"lua_rawgeti");
+    intptr_t (*toint)(void*,int)=kl_sym(image,"lua_tointeger");
+    assert(newstate&&close_state&&push&&settop&&tostring&&gc&&table&&pushint&&rawset&&rawget&&toint);
+    track=1;
+    for(int round=0;round<3;round++) {
+        void *L=newstate();assert(L);
+        char *data=malloc(8*1024*1024);assert(data);
+        for(size_t i=0;i<8*1024*1024;i++)data[i]=(char)(i*31+round);
+        for(size_t size=1024;size<=8*1024*1024;size*=2) {
+            push(L,data,size);size_t n=0;const char *copy=tostring(L,-1,&n);
+            assert(n==size && !memcmp(copy,data,size));
+        }
+        settop(L,0);gc(L,2,0);
+        table(L,0,0);
+        for(int i=1;i<=262144;i++) {pushint(L,(i*17)^0x5a5a);rawset(L,-2,i);}
+        for(int i=1;i<=262144;i+=997) {
+            rawget(L,-1,i);assert(toint(L,-1)==((i*17)^0x5a5a));settop(L,-2);
+        }
+        int before=gc(L,3,0);settop(L,0);gc(L,2,0);int after=gc(L,3,0);assert(after<before);
+        free(data);close_state(L);assert(live_bytes==0);
+        printf("PASS Lua round=%d strings/table-resize/collect/close live-mapped-bytes=%zu peak=%zu\n",round,live_bytes,peak_bytes);
+    }
+    refuse_mapping=1;
+    void *failed=newstate();
+    refuse_mapping=0;
+    assert(!failed);puts("PASS Lua newstate returns NULL on injected anonymous mmap ENOMEM");
+    void *again=newstate();assert(again);close_state(again);assert(live_bytes==0);
+    assert(*(uint32_t*)((char*)kl_base(image)+branch)==expected);
+    printf("PASS Lua allocator maps=%zu unmaps=%zu mremap=%zu failures=%zu; recovered after ENOMEM\n",maps,unmaps,remaps,failures);
+    kl_glibc_report(stderr);return 0;
+}
