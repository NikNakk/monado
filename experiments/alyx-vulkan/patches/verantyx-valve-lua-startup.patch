@@ -0,0 +1,51 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: BSL-1.0
+# Copyright 2026, Nick Kennedy
+"""Fetch only GNU C++/unwind ARM64 runtime packages into a NEW test directory.
+No installation, maintainer scripts or game modifications. HTTPS index/package
+SHA256 verification; metadata/archives and copyright files retained for audit.
+"""
+import argparse
+import gzip
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import urllib.request
+
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument('output', type=Path)
+parser.add_argument('--packages', nargs='+', choices=['libstdc++6', 'libgcc-s1', 'libuuid1'], default=['libstdc++6', 'libgcc-s1'])
+args = parser.parse_args()
+args.output.mkdir(parents=True, exist_ok=False)
+mirror = 'https://deb.debian.org/debian/'
+index_url = mirror + 'dists/trixie/main/binary-arm64/Packages.gz'
+index_data = urllib.request.urlopen(index_url, timeout=60).read()
+(args.output / 'Packages.gz').write_bytes(index_data)
+packages = {}
+for block in gzip.decompress(index_data).decode().split('\n\n'):
+    fields = dict(line.split(': ', 1) for line in block.splitlines() if ': ' in line and not line.startswith(' '))
+    if fields.get('Package') in args.packages and fields.get('Architecture') == 'arm64':
+        packages[fields['Package']] = fields
+assert set(packages) == set(args.packages)
+manifest = {'index_url': index_url, 'index_sha256': hashlib.sha256(index_data).hexdigest(), 'packages': []}
+for name, fields in sorted(packages.items()):
+    url = mirror + fields['Filename']
+    data = urllib.request.urlopen(url, timeout=60).read()
+    assert len(data) == int(fields['Size'])
+    digest = hashlib.sha256(data).hexdigest()
+    assert digest == fields['SHA256']
+    deb = args.output / Path(fields['Filename']).name
+    deb.write_bytes(data)
+    members = subprocess.check_output(['ar', 't', str(deb)], text=True).splitlines()
+    payload = next(m for m in members if m.startswith('data.tar.'))
+    archive = args.output / (name + '-' + payload)
+    archive.write_bytes(subprocess.check_output(['ar', 'p', str(deb), payload]))
+    entries = subprocess.check_output(['/usr/bin/tar', '-tf', str(archive)], text=True).splitlines()
+    selected = [p for p in entries if '/..' not in p and not p.startswith('/') and
+                (p.startswith('./usr/lib/aarch64-linux-gnu/lib') or p == './usr/share/doc/' + name + '/copyright')]
+    assert selected
+    subprocess.run(['/usr/bin/tar', '-xf', str(archive), '-C', str(args.output), *selected], check=True)
+    manifest['packages'].append({'name': name, 'version': fields['Version'], 'url': url, 'sha256': digest, 'files': selected})
+    print(name, fields['Version'], digest)
+(args.output / 'manifest.json').write_text(json.dumps(manifest, indent=2) + '\n')
