+// SPDX-License-Identifier: BSL-1.0
+// Copyright 2026, Nick Kennedy
+#include "kl_glibc.h"
+#include <assert.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+extern void *kl_shim_lookup(const char *);
+int main(void) {
+ const char *home=getenv("HOME");assert(home);char *original=strdup(home);assert(original);
+ kl_glibc_install("guest-home-fixture");char *(*guest_getenv)(const char*)=kl_shim_lookup("getenv");assert(guest_getenv);
+ setenv("VERANTYX_GUEST_HOME","/private/tmp/owned-guest-home-fixture",1);
+ assert(!strcmp(guest_getenv("HOME"),"/private/tmp/owned-guest-home-fixture"));
+ assert(!strcmp(getenv("HOME"),original));
+ setenv("VALVE_HOME_FIXTURE","value",1);assert(!strcmp(guest_getenv("VALVE_HOME_FIXTURE"),"value"));
+ unsetenv("VERANTYX_GUEST_HOME");assert(!strcmp(guest_getenv("HOME"),original));free(original);
+ puts("PASS: guest HOME redirect leaves native HOME unchanged; other variables and default path preserve behaviour");
+}
