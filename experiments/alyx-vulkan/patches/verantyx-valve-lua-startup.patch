+#!/usr/bin/env python3
+# SPDX-License-Identifier: BSL-1.0
+# Copyright 2026, Nick Kennedy
+"""Run the explicitly built headless Valve Lua test in a NEW isolated directory."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import struct
+
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument('--executable', type=Path, required=True)
+parser.add_argument('--depot', type=Path, required=True)
+parser.add_argument('--runtime', type=Path, required=True)
+parser.add_argument('--output', type=Path, required=True)
+args = parser.parse_args()
+args.output = args.output.resolve()
+args.output.mkdir(parents=True, exist_ok=False)
+libs = args.output / 'lib'
+libs.mkdir()
+original = args.depot.resolve() / 'game/bin/linuxsteamrtarm64'
+files = [original / n for n in ('libvscript.so', 'libtier0.so', 'libvstdlib.so')]
+files += [args.runtime.resolve() / 'usr/lib/aarch64-linux-gnu' / n for n in ('libstdc++.so.6', 'libgcc_s.so.1')]
+for p in files:
+    assert p.is_file(), p
+    (libs / p.name).symlink_to(p)
+def hashes():
+    return {p.name: hashlib.sha256(p.read_bytes()).hexdigest() for p in files}
+# Discover binding/range-check locations from the actual input, not a fixed build offset.
+elf = files[0].read_bytes()
+shoff = struct.unpack_from('<Q', elf, 40)[0]
+shsize, shnum = struct.unpack_from('<HH', elf, 58)
+assert shsize == 64
+sections = [struct.unpack_from('<IIQQQQIIQQ', elf, shoff + i * shsize) for i in range(shnum)]
+slots = []
+for section in sections:
+    if section[1] != 4: continue
+    dynsym = sections[section[6]]
+    strings = sections[dynsym[6]]
+    for offset in range(section[4], section[4] + section[5], section[9]):
+        address, info, addend = struct.unpack_from('<QQq', elf, offset)
+        if (info & 0xffffffff) != 1026: continue
+        name_offset = struct.unpack_from('<I', elf, dynsym[4] + (info >> 32) * dynsym[9])[0]
+        begin = strings[4] + name_offset
+        if elf[begin:elf.index(b'\0', begin)] == b'lua_VALVE_OVERRIDE_MMAP': slots.append(address)
+assert len(slots) == 1
+pattern = struct.pack('<5I', 0xd2b00001, 0xa9025bf5, 0xaa0003f5, 0xcb130021, 0xeb01001f)
+branches = []
+for section in sections:
+    if not (section[2] & 4): continue
+    data = elf[section[4]:section[4] + section[5]]
+    start = 0
+    while True:
+        match = data.find(pattern, start)
+        if match < 0: break
+        branch = struct.unpack_from('<I', data, match + len(pattern))[0]
+        if (branch & 0xff00001f) == 0x54000008:
+            branches.append((section[3] + match + len(pattern), branch))
+        start = match + 4
+assert len(branches) == 1
+before = hashes()
+# Prevent inherited debug toggles from skipping constructors or enabling repairs.
+env = {k: v for k, v in os.environ.items() if not k.startswith(('KL_', 'VERANTYX_', 'MVK_CONFIG_'))}
+try:
+    with (args.output / 'run.log').open('w') as log:
+        try:
+            result = subprocess.run([str(args.executable.resolve()), str(libs), hex(slots[0]), hex(branches[0][0]), hex(branches[0][1])], cwd=args.output,
+                                    env=env, stdout=log, stderr=subprocess.STDOUT, timeout=30)
+            status = result.returncode
+        except subprocess.TimeoutExpired:
+            status = 'timeout'
+finally:
+    after = hashes()
+    (args.output / 'hashes.json').write_text(json.dumps({'before': before, 'after': after,
+                          'returncode': locals().get('status', 'exception')}, indent=2) + '\n')
+    assert before == after, 'input files changed'
+print('output:', args.output, 'returncode:', status, 'five input hashes unchanged')
+print((args.output / 'run.log').read_text()[-10000:])
+raise SystemExit(0 if status == 0 else 1)
