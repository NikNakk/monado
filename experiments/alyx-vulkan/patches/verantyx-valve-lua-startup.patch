+typedef struct {uint32_t name,type;uint64_t flags,addr,offset,size;uint32_t link,info;uint64_t alignment,entry;} shdr;
+static void check_sections(int mode,const char *expected) {
+ uint8_t buf[320]={0};ehdr *e=(void*)buf;
+ memcpy(e->ident,"\177ELF\2\1\1",7);e->machine=183;e->type=3;e->version=1;
+ e->ehsize=sizeof *e;e->phoff=sizeof *e;e->phsize=sizeof(phdr);e->phnum=1;
+ e->shoff=128;e->shsize=sizeof(shdr);e->shnum=3;
+ phdr *p=(void*)(buf+e->phoff);p->type=1;p->flags=5;p->offset=120;p->va=0x1000;p->filesz=8;p->memsz=8;p->align=4;
+ uint32_t code=mode==1?0xd4000001:0xd503201f,data=0xd4000001;
+ memcpy(buf+120,&code,4);memcpy(buf+124,&data,4);
+ shdr *sh=(void*)(buf+128);
+ sh[1]=(shdr){.type=1,.flags=6,.addr=0x1000,.offset=120,.size=4};
+ sh[2]=(shdr){.type=1,.flags=2,.addr=0x1004,.offset=124,.size=4};
+ if(mode==2)e->shoff=10000;
+ if(mode==3)sh[1].offset=10000;
+ if(mode==4)sh[1].addr=0x2000;
+ char path[]="/private/tmp/kl-svc-sections.XXXXXX";int fd=mkstemp(path);assert(fd>=0);
+ assert(write(fd,buf,sizeof buf)==sizeof buf);close(fd);
+ assert(!kl_load(path));assert(strstr(kl_error(),expected));unlink(path);
+}
