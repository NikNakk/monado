+#!/usr/bin/env python3
+# SPDX-License-Identifier: BSL-1.0
+# Copyright 2026, Nick Kennedy
+"""Build a NEW read-only-input flat library search directory for an isolated root."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import re
+import subprocess
+parser=argparse.ArgumentParser(description=__doc__)
+parser.add_argument('--game',type=Path,required=True)
+parser.add_argument('--runtime',type=Path,required=True)
+parser.add_argument('--output',type=Path,required=True)
+parser.add_argument('--extra-runtime',type=Path,nargs='*',default=[])
+args=parser.parse_args()
+args.output.mkdir(parents=True,exist_ok=False)
+sources=[args.game/'game/bin/linuxsteamrtarm64', args.game/'game/hlvr/bin/linuxsteamrtarm64',
+         args.runtime/'usr/lib/aarch64-linux-gnu'] + [p/'usr/lib/aarch64-linux-gnu' for p in args.extra_runtime]
+entries={}
+aliases={}
+for directory in sources:
+    for path in sorted(directory.glob('*.so*')):
+        if not path.is_file() or path.name in ('libvulkan_freedreno_hlvr.so','libmimalloc.so'):continue
+        with path.open('rb') as f:
+            if f.read(4)!=b'\x7fELF':continue
+        if path.name in entries and hashlib.sha256(entries[path.name].read_bytes()).digest()!=hashlib.sha256(path.read_bytes()).digest():
+            raise ValueError('conflicting exact library filename: '+path.name)
+        entries[path.name]=path
+        text=subprocess.check_output(['/opt/homebrew/opt/llvm/bin/llvm-readelf','-d',str(path)],text=True)
+        match=re.search(r'\(SONAME\).*?\[(.*?)\]',text)
+        names={path.name.split('.so')[0]+'.so'}
+        if match:names.add(match[1])
+        for name in names:
+            assert '/' not in name and name not in ('.','..')
+            aliases.setdefault(name,path)
+# An actual supplied filename always wins over a generated SONAME/bare alias.
+for name,path in aliases.items():entries.setdefault(name,path)
+manifest={}
+for name,path in sorted(entries.items()):
+    (args.output/name).symlink_to(path.resolve());manifest[name]=str(path.resolve())
+(args.output/'libraries.json').write_text(json.dumps(manifest,indent=2,sort_keys=True)+'\n')
+print('library names:',len(manifest))
