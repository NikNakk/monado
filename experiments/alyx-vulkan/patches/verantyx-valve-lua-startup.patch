+// SPDX-License-Identifier: BSL-1.0
+// Copyright 2026, Nick Kennedy
+// Mapping/relocation diagnostic only. No guest constructors or entry points.
+#include "klepton.h"
+#include "kl_glibc.h"
+#include "kl_lua_builtin.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+static kl_image *images[512];static char names[512][128];static unsigned count;
+static void image_seen(const char *path,kl_image *img) {
+ if(count>=512)abort();images[count]=img;
+ const char *name=strrchr(path,'/');snprintf(names[count++],128,"%s",name?name+1:path);
+}
+int main(int argc,char **argv) {
+ if(argc!=3){fprintf(stderr,"usage: %s LIBDIR BASENAME.so\n",argv[0]);return 2;}
+ setvbuf(stdout,NULL,_IONBF,0);setvbuf(stderr,NULL,_IONBF,0);
+ setenv("KL_LOAD_NO_INIT","1",1);setenv("KL_SVC_POLICY","trap-code",1);
+ setenv("KL_GUEST_PATCH","0",1);setenv("KL_VK_STRICT","1",1);
+ setenv("KL_GUEST_THREAD_TRACKING","1",1);setenv("KL_TLS_REWRITE_FORCE","1",1);unsetenv("KL_DYLIB_DIR");
+ kl_glibc_install(argv[0]);kl_set_library_path(argv[1]);kl_thread_init();kl_lua_builtin_install();
+ kl_image_loaded_hook=image_seen;
+ char path[4096];snprintf(path,sizeof path,"%s/%s",argv[1],argv[2]);
+ kl_image *root=kl_load_recursive(path);int bad=!root;
+ if(!root)fprintf(stderr,"PREFLIGHT load failure: %s\n",kl_error());
+ for(unsigned i=0;i<count;i++) {
+  const kl_stats *s=kl_get_stats(images[i]);unsigned n=0;
+  const char *const *missing=kl_missing_imports(images[i],&n);
+  printf("PREFLIGHT %s imports=%u TLS=%u x18=%u CTR=%u SVC=%u trapped=%u refused=%u/%u/%u\n",names[i],n,s->tls_rewrites,s->x18_patched,s->ctr_patched,s->svc_sites,s->svc_trapped,s->tls_refused,s->x18_refused,s->ctr_refused);
+  for(unsigned k=0;k<n;k++)printf("UNRESOLVED %s %s\n",names[i],missing[k]);
+  if(n||s->svc_sites!=s->svc_trapped||s->tls_refused||s->x18_refused||s->ctr_refused)bad=1;
+ }
+ printf("PREFLIGHT result=%s loaded=%u no guest constructors/entry points executed\n",bad?"FAIL":"PASS",count);
+ return bad?3:0;
+}
