--- /dev/null
+++ b/NativeARM/scripts/clone_game_root.py
@@ -0,0 +1,63 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: BSL-1.0
+# Copyright 2026, Nick Kennedy
+"""Create a NEW APFS copy-on-write Alyx root; never write through source links.
+No full-copy fallback or deletion of existing output. Existing game files are
+never modified. Input directories must contain ordinary files/directories.
+"""
+import argparse
+import ctypes
+import json
+import os
+from pathlib import Path
+
+libc = ctypes.CDLL('/usr/lib/libSystem.B.dylib', use_errno=True)
+libc.clonefile.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_int]
+libc.clonefile.restype = ctypes.c_int
+
+def clone(source, target):
+    if libc.clonefile(os.fsencode(source), os.fsencode(target), 0):
+        code = ctypes.get_errno()
+        raise OSError(code, 'APFS clone failed; no full-copy fallback: ' + os.strerror(code), str(source))
+    assert source.stat().st_ino != target.stat().st_ino
+
+def overlay(source, target, counts):
+    if source.is_symlink():
+        raise ValueError('input symlink requires review: ' + str(source))
+    if source.is_dir():
+        target.mkdir(exist_ok=True)
+        for p in sorted(source.iterdir()):
+            if p.name != '.DS_Store': overlay(p, target / p.name, counts)
+    elif source.is_file():
+        if target.exists():
+            if target.is_symlink() or not target.is_file(): raise ValueError(str(target))
+            target.unlink()  # exclusively owned clone in this newly created root
+        clone(source, target)
+        counts['files'] += 1
+        counts['logical_bytes'] += source.stat().st_size
+    else:
+        raise ValueError('unsupported input: ' + str(source))
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--content', type=Path, required=True)
+    parser.add_argument('--depot', type=Path, required=True)
+    parser.add_argument('--output', type=Path, required=True)
+    args = parser.parse_args()
+    content, depot, output = args.content.resolve(), args.depot.resolve(), args.output.resolve()
+    assert (content / 'game/hlvr/pak01_dir.vpk').is_file()
+    assert (depot / 'game/bin/linuxsteamrtarm64/libengine2.so').is_file()
+    for root in (content, depot):
+        assert not output.is_relative_to(root), 'output must be outside source tree'
+    output.mkdir(parents=True, exist_ok=False)
+    counts = {'files': 0, 'logical_bytes': 0}
+    overlay(content / 'game', output / 'game', counts)
+    overlay(depot / 'game', output / 'game', counts)
+    (output / 'cache').mkdir()
+    (output / 'steam_appid.txt').write_text('546560\n')
+    report = {'content': str(content), 'depot': str(depot), 'output': str(output),
+              'method': 'APFS clonefile; separate inodes; no symlink write-through', **counts}
+    (output / 'clone-manifest.json').write_text(json.dumps(report, indent=2) + '\n')
+    print(json.dumps(report, indent=2))
+
+if __name__ == '__main__': main()
