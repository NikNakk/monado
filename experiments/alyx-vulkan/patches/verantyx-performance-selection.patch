+#!/usr/bin/env python3
+# Copyright 2026, Nick Kennedy
+# SPDX-License-Identifier: BSL-1.0
+"""Summarize xrizer API wall durations/cadence. No GPU or presentation estimates."""
+import argparse
+import csv
+import json
+import math
+from collections import defaultdict
+from pathlib import Path
+
+
+def distribution(values):
+    values=sorted(values)
+    def percentile(p):
+        at=(len(values)-1)*p
+        lo=int(at)
+        return values[lo]+(values[min(lo+1,len(values)-1)]-values[lo])*(at-lo)
+    return {'count':len(values),'median_ms':percentile(.5),
+            'p95_ms':percentile(.95),'p99_ms':percentile(.99)}
+
+
+def summarize(path, start=0.0, end=math.inf):
+    groups=defaultdict(list)
+    waits=[]
+    with Path(path).open(newline='') as stream:
+        for row in csv.DictReader(stream):
+            timestamp=int(row['start_ns'])/1e9
+            duration=int(row['duration_ns'])/1e6
+            if duration<0:raise ValueError('negative API duration')
+            if not start<=timestamp<end:continue
+            key=row['event']+(':eye'+row['eye'] if row['event']=='submit' else '')
+            groups[key].append(duration)
+            if row['event']=='wait_poses':waits.append(timestamp)
+    waits.sort()
+    intervals=[(b-a)*1000 for a,b in zip(waits,waits[1:])]
+    result={'measurement':'API wall durations, including blocking; not CPU busy, GPU execution, or presentation latency',
+            'window_seconds':[start,end if math.isfinite(end) else None],
+            'api_wall':{key:distribution(values) for key,values in sorted(groups.items())},
+            'caution':'nested handoff may be included in wait_poses; do not sum these durations'}
+    if intervals:result['wait_poses_start_interval']=distribution(intervals)
+    return result
+
+
+if __name__=='__main__':
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('csv',type=Path)
+    parser.add_argument('--start-seconds',type=float,default=0)
+    parser.add_argument('--end-seconds',type=float,default=math.inf)
+    args=parser.parse_args()
+    if not 0<=args.start_seconds<args.end_seconds:parser.error('invalid time window')
+    print(json.dumps(summarize(args.csv,args.start_seconds,args.end_seconds),indent=2,allow_nan=False))
