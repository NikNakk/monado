diff --git a/NativeARM/host/kl_platform_vm.c b/NativeARM/host/kl_platform_vm.c
new file mode 100644
index 0000000..c1d055d
--- /dev/null
+++ b/NativeARM/host/kl_platform_vm.c
@@ -0,0 +1,154 @@
+// Copyright 2026, Nick Kennedy
+// SPDX-License-Identifier: BSL-1.0
+#include "kl_platform_vm.h"
+#include "klepton.h"
+#include <errno.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+// Source's Linux platform allocator uses 4KiB commit/decommit granularity even
+// when libc reports a larger page. Track ONLY reservations made through these
+// platform exports. The host protection of each page is the union of its live
+// guest subpages: decommitting one never revokes a live neighbour's access.
+// This supplies real backing and preserves data, but cannot provide 4KiB guard
+// faults on a 16KiB host. No executable-memory workaround or arbitrary libc
+// mprotect rounding is provided.
+#define GUEST_PAGE 4096u
+struct reservation {
+    unsigned char *base, *protection;
+    size_t size;
+    struct reservation *next;
+};
+static struct reservation *reservations;
+static pthread_mutex_t lock=PTHREAD_MUTEX_INITIALIZER;
+static size_t host_page;
+static unsigned commit_messages;
+static void *original(const char *name) {
+    kl_image *image=kl_find_image("libtier0.so");
+    void *fn=image ? kl_sym(image,name) : NULL;
+    if(!fn) {fprintf(stderr,"[platform-vm] missing original %s; refusing\n",name);abort();}
+    return fn;
+}
+static int rounded(size_t n,size_t alignment,size_t *out) {
+    if(!n || n>SIZE_MAX-(alignment-1))return 0;
+    *out=(n+alignment-1)&~(alignment-1);return 1;
+}
+static struct reservation *find(void *address,size_t n) {
+    uintptr_t a=(uintptr_t)address;
+    for(struct reservation *r=reservations;r;r=r->next) {
+        uintptr_t b=(uintptr_t)r->base;
+        if(a>=b && a-b<r->size && n<=r->size-(a-b))return r;
+    }
+    return NULL;
+}
+static int page_protection(const unsigned char *p,size_t count) {
+    int result=0;for(size_t i=0;i<count;i++)result|=p[i];return result;
+}
+// Called under lock. A failed host update restores previously changed pages;
+// guest bookkeeping changes only after every host update succeeds.
+static int protect(struct reservation *r,void *address,size_t n,int access) {
+    size_t length;
+    if(((uintptr_t)address&(GUEST_PAGE-1)) || !rounded(n,GUEST_PAGE,&length) ||
+       !find(address,length) || (access&~(PROT_READ|PROT_WRITE))) {
+        errno=(access&PROT_EXEC)?EPERM:EINVAL;return 0;
+    }
+    size_t first=((unsigned char*)address-r->base)/GUEST_PAGE;
+    size_t last=first+length/GUEST_PAGE, per_host=host_page/GUEST_PAGE;
+    size_t begin=first/per_host, end=(last+per_host-1)/per_host;
+    for(size_t page=begin;page<end;page++) {
+        int permissions=0;
+        for(size_t sub=page*per_host;sub<(page+1)*per_host;sub++)
+            permissions|=(sub>=first && sub<last)?access:r->protection[sub];
+        if(mprotect(r->base+page*host_page,host_page,permissions)) {
+            int saved=errno;
+            for(size_t undo=begin;undo<page;undo++) {
+                int old=page_protection(r->protection+undo*per_host,per_host);
+                if(mprotect(r->base+undo*host_page,host_page,old)) {
+                    fprintf(stderr,"[platform-vm] protection rollback failed; refusing\n");abort();
+                }
+            }
+            errno=saved;return 0;
+        }
+    }
+    memset(r->protection+first,access,last-first);
+    return 1;
+}
+static void *allocate(void *address,size_t n,int type,int access,void *maximum) {
+    void *(*real)(void*,size_t,int,int,void*)=original("Plat_VirtualAlloc");
+    if(host_page==GUEST_PAGE)return real(address,n,type,access,maximum);
+    pthread_mutex_lock(&lock);
+    struct reservation *r=find(address,1);
+    if(type==2 && r) {
+        int ok=protect(r,address,n,access);int saved=errno;
+        if(ok && (((uintptr_t)address&(host_page-1)) || (n&(host_page-1))) && commit_messages<8) {
+            commit_messages++;
+            fprintf(stderr,"[platform-vm] subpage commit translated offset=%zu size=%zu host-page=%zu\n",
+                (size_t)((unsigned char*)address-r->base),n,host_page);
+        }
+        if(!ok)fprintf(stderr,"[platform-vm] commit refused address=%p size=%zu access=%d errno=%d\n",address,n,access,saved);
+        pthread_mutex_unlock(&lock);errno=saved;return ok?address:NULL;
+    }
+    // Preserve native handling of special flags, maximum-address requests,
+    // executable mappings and operations outside reservations we own.
+    if((type!=1 && type!=3) || maximum || (access&~3)) {
+        pthread_mutex_unlock(&lock);return real(address,n,type,access,maximum);
+    }
+    size_t size,span;
+    if(!rounded(n,GUEST_PAGE,&size) || !rounded(n,host_page,&span)) {
+        pthread_mutex_unlock(&lock);errno=EINVAL;return NULL;
+    }
+    r=calloc(1,sizeof *r);
+    if(r)r->protection=calloc(span/GUEST_PAGE,1);
+    if(!r || !r->protection) {
+        free(r);pthread_mutex_unlock(&lock);errno=ENOMEM;return NULL;
+    }
+    void *base=real(address,n,type,access,maximum);int saved=errno;
+    if(!base) {free(r->protection);free(r);pthread_mutex_unlock(&lock);errno=saved;return NULL;}
+    r->base=base;r->size=size;
+    if(type==3)memset(r->protection,access,size/GUEST_PAGE);
+    r->next=reservations;reservations=r;
+    pthread_mutex_unlock(&lock);errno=saved;return base;
+}
+static int release(void *address,size_t n,int type) {
+    int (*real)(void*,size_t,int)=original("Plat_VirtualFree");
+    pthread_mutex_lock(&lock);
+    struct reservation *r=find(address,1);
+    if(r && type==4) {
+        int ok=protect(r,address,n,PROT_NONE);int saved=errno;
+        pthread_mutex_unlock(&lock);errno=saved;return ok;
+    }
+    size_t released_size=0;
+    if(r && type==8 && (address!=r->base || !rounded(n,GUEST_PAGE,&released_size) || released_size!=r->size)) {
+        pthread_mutex_unlock(&lock);errno=EINVAL;return 0;
+    }
+    int ok=real(address,n,type);int saved=errno;
+    if(ok && r && type==8) {
+        struct reservation **link=&reservations;while(*link!=r)link=&(*link)->next;
+        *link=r->next;free(r->protection);free(r);
+    }
+    pthread_mutex_unlock(&lock);errno=saved;return ok;
+}
+static int change_access(void *address,size_t n,int access) {
+    pthread_mutex_lock(&lock);struct reservation *r=find(address,1);
+    if(r) {
+        int ok=protect(r,address,n,access);int saved=errno;
+        pthread_mutex_unlock(&lock);errno=saved;return ok;
+    }
+    pthread_mutex_unlock(&lock);
+    int (*real)(void*,size_t,int)=original("Plat_VirtualProtect");
+    return real(address,n,access);
+}
+void kl_platform_vm_install(void) {
+    host_page=getpagesize();
+    if(host_page<GUEST_PAGE || host_page%GUEST_PAGE || (host_page&(host_page-1)))abort();
+    if(host_page==GUEST_PAGE)return;
+    kl_interpose("Plat_VirtualAlloc",allocate);
+    kl_interpose("Plat_VirtualFree",release);
+    kl_interpose("Plat_VirtualProtect",change_access);
+    fprintf(stderr,"[platform-vm] guest commit=4096 host protection=%zu; subpage protections are combined; 4KiB guard faults unavailable\n",host_page);
+}
