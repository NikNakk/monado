diff --git a/NativeARM/host/tests/valve_vm_pages.c b/NativeARM/host/tests/valve_vm_pages.c
new file mode 100644
index 0000000..49c5535
--- /dev/null
+++ b/NativeARM/host/tests/valve_vm_pages.c
@@ -0,0 +1,103 @@
+// Copyright 2026, Nick Kennedy
+// SPDX-License-Identifier: BSL-1.0
+// Owner-supplied tier0 platform VM exports only. No game/Steam/OpenXR entry.
+#include "klepton.h"
+#include "kl_glibc.h"
+#include "kl_fault.h"
+#include "kl_platform_vm.h"
+#include <mach/mach.h>
+#include <mach/mach_vm.h>
+#include <string.h>
+#include <assert.h>
+#include <errno.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/mman.h>
+#include <unistd.h>
+static void safety(const char *path, kl_image *image) {
+    const kl_stats *s=kl_get_stats(image); unsigned missing; kl_missing_imports(image,&missing);
+    if(missing || s->svc_sites!=s->svc_trapped || s->tls_refused || s->x18_refused || s->ctr_refused) {
+        fprintf(stderr,"VM image refused: %s missing=%u\n",path,missing);exit(3);
+    }
+}
+static int permissions(void *address) {
+    mach_vm_address_t start=(uintptr_t)address;mach_vm_size_t size;
+    vm_region_basic_info_data_64_t info;mach_msg_type_number_t count=VM_REGION_BASIC_INFO_COUNT_64;
+    mach_port_t object=MACH_PORT_NULL;
+    assert(mach_vm_region(mach_task_self(),&start,&size,VM_REGION_BASIC_INFO_64,
+        (vm_region_info_t)&info,&count,&object)==KERN_SUCCESS);
+    if(object!=MACH_PORT_NULL)mach_port_deallocate(mach_task_self(),object);
+    assert(start<=(uintptr_t)address && (uintptr_t)address-start<size);
+    return info.protection;
+}
+int main(int argc,char **argv) {
+    assert(argc==2 || (argc==3 && !strcmp(argv[2],"--adapted")));
+    int adapted=argc==3;setvbuf(stdout,NULL,_IONBF,0);setvbuf(stderr,NULL,_IONBF,0);
+    setenv("KL_LOAD_DEFER_INIT","1",1);setenv("KL_LOAD_NO_INIT","0",1);
+    setenv("KL_SVC_POLICY","trap-code",1);setenv("KL_GUEST_PATCH","0",1);
+    setenv("KL_TLS_REWRITE_FORCE","1",1);setenv("KL_GUEST_THREAD_TRACKING","1",1);
+    kl_glibc_install(argv[0]);kl_set_library_path(argv[1]);kl_thread_init();kl_fault_install();
+    if(adapted)kl_platform_vm_install();
+    kl_image_loaded_hook=safety;
+    char path[4096];snprintf(path,sizeof path,"%s/libtier0.so",argv[1]);
+    kl_image *image=kl_load_recursive(path);assert(image);
+    void *(*alloc)(void*,size_t,int,int,void*)=kl_sym(image,"Plat_VirtualAlloc");
+    int (*release)(void*,size_t,int)=kl_sym(image,"Plat_VirtualFree");
+    int (*change)(void*,size_t,int)=kl_sym(image,"Plat_VirtualProtect");
+    if(adapted) {
+        alloc=kl_interpose_lookup("Plat_VirtualAlloc");
+        release=kl_interpose_lookup("Plat_VirtualFree");
+        change=kl_interpose_lookup("Plat_VirtualProtect");
+    }
+    assert(alloc && release && change);size_t page=getpagesize();assert(page==16384);
+    unsigned char *base=alloc(NULL,65536,1,0,NULL);assert(base);
+    printf("VM reserve 65536 host-page=%zu base=%p\n",page,base);
+    for(size_t offset=0;offset<page;offset+=4096) {
+        errno=0;void *p=alloc(base+offset,4096,2,3,NULL);int saved=errno;
+        printf("VM commit offset=%zu length=4096 result=%p errno=%d\n",offset,p,saved);
+        if(!offset || adapted) {assert(p==base+offset);base[offset]=0x5a;}
+        else assert(!p && saved==EINVAL);
+    }
+    assert(base[0]==0x5a);
+    if(adapted) {
+        for(size_t offset=0;offset<page;offset+=4096)assert(base[offset]==0x5a);
+        // Removing one subpage must not revoke or erase its live neighbours.
+        assert(release(base+4096,4096,4));assert(base[8192]==0x5a);
+        assert(permissions(base)==(VM_PROT_READ|VM_PROT_WRITE));
+        assert(release(base,4096,4));assert(release(base+8192,4096,4));
+        assert(release(base+12288,4096,4));assert(permissions(base)==VM_PROT_NONE);
+        assert(alloc(base+4096,4096,2,3,NULL)==base+4096);assert(base[4096]==0x5a);
+        assert(change(base+4096,4096,PROT_READ));assert(permissions(base)==VM_PROT_READ);
+        errno=0;assert(!change(base+4096,4096,PROT_EXEC) && errno==EPERM);
+        assert(permissions(base)==VM_PROT_READ);
+        errno=0;assert(!alloc(base+1,4096,2,3,NULL) && errno==EINVAL);
+        errno=0;assert(!release(base+4096,4096,8) && errno==EINVAL);
+        errno=0;assert(!alloc(base,65537,2,3,NULL) && errno==EINVAL);
+        errno=0;assert(!release(base,65537,8) && errno==EINVAL);
+        assert(change(base+4096,4096,3));base[4096]=0x6b;
+        // A range crossing host pages preserves independent permissions.
+        assert(alloc(base+12288,8192,2,3,NULL)==base+12288);
+        base[16384]=0x7c;assert(release(base+12288,4096,4));assert(base[16384]==0x7c);
+        assert(change(base+4096,4096,PROT_READ));
+        assert(permissions(base)==VM_PROT_READ);
+        assert(permissions(base+16384)==(VM_PROT_READ|VM_PROT_WRITE));
+    }
+    assert(release(base,65536,8));
+    base=alloc(NULL,65536,1,0,NULL);assert(base);
+    for(size_t offset=0;offset<65536;offset+=page) {
+        assert(alloc(base+offset,page,2,3,NULL)==base+offset);
+        for(size_t i=0;i<page;i++)base[offset+i]=(unsigned char)(offset/page+1);
+    }
+    for(size_t i=0;i<65536;i++)assert(base[i]==(unsigned char)(i/page+1));
+    assert(release(base,65536,8));
+    if(adapted) {
+        // Non-page-sized reservation/release lengths use Linux page rounding.
+        base=alloc(NULL,5000,1,0,NULL);assert(base);
+        assert(alloc(base+4096,1,2,3,NULL)==base+4096);base[4096]=0x41;
+        assert(release(base,5000,8));
+    }
+    kl_glibc_report(stderr);
+    if(adapted)puts("PASS: adapted 4KiB commit/decommit/protect, neighbour data, host permissions, invalid/exec/partial-release rejection; 16KiB lifecycle");
+    else puts("PASS: real tier0 reproduces 4KiB commit failure; host-aligned 16KiB commit/write/read/release succeeds");
+}
