From 2ba3b7f949e22f2b4d2249705cdf6bd3dbb9b23c Mon Sep 17 00:00:00 2001
From: Nick Kennedy <nick@nick-kennedy.com>
Date: Tue, 20 Oct 2026 08:45:35 +0200
Subject: [PATCH 3/3] loader: add explicit recursive relocation-only diagnostic
 mode

Signed-off-by: Nick Kennedy <nick@nick-kennedy.com>
---
 runtime/kl_dl.c | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/runtime/kl_dl.c b/runtime/kl_dl.c
index 538c9df..b3936b9 100644
--- a/runtime/kl_dl.c
+++ b/runtime/kl_dl.c
@@ -468,8 +468,12 @@ static kl_image *kl_load_recursive_inner(const char *path) {
     kl_image *img = kl_load_auto(path);
     if (!img) return NULL;
     kl_register_image(path, img);
-    kl_run_init(img);
-    kl_maybe_jni_onload(path, img);
+    if (kl_env_on("KL_LOAD_NO_INIT", 0)) {
+        fprintf(stderr, "  [dl] diagnostic KL_LOAD_NO_INIT: no constructors/JNI for %s\n", path);
+    } else {
+        kl_run_init(img);
+        kl_maybe_jni_onload(path, img);
+    }
     return img;
 }
 
