From c964fce706668de32f062570c51e32631e81cfbc Mon Sep 17 00:00:00 2001
From: Nick Kennedy <nick@nick-kennedy.com>
Date: Wed, 21 Oct 2026 00:28:58 +0100
Subject: [PATCH] vk: only use external fd sync objects when their extension is
 enabled

A driver can report SYNC_FD/OPAQUE_FD export support while the app's
device did not enable VK_KHR_external_fence_fd or
VK_KHR_external_semaphore_fd. The client compositor then calls an
unloaded vkGetFenceFdKHR. KosmicKrisp hits this on macOS; MoltenVK
reports no fd support, so it never did.

Test-only branch for the KosmicKrisp probe; not for the Alyx build.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/xrt/auxiliary/vk/vk_bundle_init.c | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/src/xrt/auxiliary/vk/vk_bundle_init.c b/src/xrt/auxiliary/vk/vk_bundle_init.c
index c61da00cc..be536b502 100644
--- a/src/xrt/auxiliary/vk/vk_bundle_init.c
+++ b/src/xrt/auxiliary/vk/vk_bundle_init.c
@@ -389,20 +389,20 @@ fill_in_external_object_properties(struct vk_bundle *vk)
 #endif
 #if defined(XRT_GRAPHICS_SYNC_HANDLE_IS_FD)
 
-	vk->external.fence_sync_fd = is_fence_bit_supported( //
+	vk->external.fence_sync_fd = vk->has_KHR_external_fence_fd && is_fence_bit_supported( //
 	    vk, VK_EXTERNAL_FENCE_HANDLE_TYPE_SYNC_FD_BIT);
-	vk->external.fence_opaque_fd = is_fence_bit_supported( //
+	vk->external.fence_opaque_fd = vk->has_KHR_external_fence_fd && is_fence_bit_supported( //
 	    vk, VK_EXTERNAL_FENCE_HANDLE_TYPE_OPAQUE_FD_BIT);
 
-	vk->external.binary_semaphore_sync_fd = is_binary_semaphore_bit_supported( //
+	vk->external.binary_semaphore_sync_fd = vk->has_KHR_external_semaphore_fd && is_binary_semaphore_bit_supported( //
 	    vk, VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_SYNC_FD_BIT);
-	vk->external.binary_semaphore_opaque_fd = is_binary_semaphore_bit_supported( //
+	vk->external.binary_semaphore_opaque_fd = vk->has_KHR_external_semaphore_fd && is_binary_semaphore_bit_supported( //
 	    vk, VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_OPAQUE_FD_BIT);
 
 	//! @todo Is this safe to assume working, do we need to check an extension?
-	vk->external.timeline_semaphore_sync_fd = is_timeline_semaphore_bit_supported( //
+	vk->external.timeline_semaphore_sync_fd = vk->has_KHR_external_semaphore_fd && is_timeline_semaphore_bit_supported( //
 	    vk, VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_SYNC_FD_BIT);
-	vk->external.timeline_semaphore_opaque_fd = is_timeline_semaphore_bit_supported( //
+	vk->external.timeline_semaphore_opaque_fd = vk->has_KHR_external_semaphore_fd && is_timeline_semaphore_bit_supported( //
 	    vk, VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_OPAQUE_FD_BIT);
 
 #elif defined(XRT_GRAPHICS_SYNC_HANDLE_IS_WIN32_HANDLE)
