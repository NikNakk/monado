# Opt-in fixed-depth candidate, custom resolve enabled, ordinary timing host.
set -eu
base=${ALYX_NATIVE_ROOT:-"$HOME/Code/alyx-native"}
exec python3 "$base/with-matching-monado.py" \
 --build "$base/build/monado-kk-fd-guard" -- \
 "$base/run-alyx-gpu-timing" \
 --driver kosmickrisp \
 --icd "$base/build/kk-custom-resolve-final/icd.json" \
 --runtime-json "$base/build/monado-kk-fd-guard/openxr_monado-dev.json" \
 --extended-dynamic-state3 disabled --sample-locations-compat enabled \
 --api-trace "$@"
