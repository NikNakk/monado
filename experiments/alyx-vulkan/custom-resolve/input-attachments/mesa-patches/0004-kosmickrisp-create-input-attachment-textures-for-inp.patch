From 167f74a3360d2377f4905ceef7d7e54bbdc139e9 Mon Sep 17 00:00:00 2001
From: Nick Kennedy <nick@nick-kennedy.com>
Date: Wed, 21 Oct 2026 18:00:58 +0100
Subject: [PATCH 4/5] kosmickrisp: create input attachment textures for
 input-only image views

kk_image_view_init only created mtl_handle_input when the view had a
colour or depth/stencil attachment usage. A view whose usage is limited
to INPUT_ATTACHMENT (for example through VkImageViewUsageCreateInfo) got
no input texture, so its descriptor held a zero resource ID and shader
reads returned zero. Native Half-Life: Alyx reads its multisampled scene
this way in the VK_EXT_custom_resolve shader, so the resolved scene came
out black.

Create the input texture for any of the three usages, and keep the
render texture limited to attachment usage.

AI-written commit text (biblioklept).

Generated-by: LLM
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/kosmickrisp/vulkan/kk_image_view.c | 21 +++++++++++++--------
 1 file changed, 13 insertions(+), 8 deletions(-)

diff --git a/src/kosmickrisp/vulkan/kk_image_view.c b/src/kosmickrisp/vulkan/kk_image_view.c
index 90eb6f6..63975df 100644
--- a/src/kosmickrisp/vulkan/kk_image_view.c
+++ b/src/kosmickrisp/vulkan/kk_image_view.c
@@ -201,7 +201,8 @@ kk_image_view_init(struct kk_device *dev, struct kk_image_view *view,
       }
 
       if (view->vk.usage & (VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT |
-                            VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT)) {
+                            VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT |
+                            VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT)) {
          bool requires_type_change =
             view_layout.view_type != VK_IMAGE_VIEW_TYPE_3D &&
             view_layout.view_type != VK_IMAGE_VIEW_TYPE_2D_ARRAY;
@@ -225,13 +226,17 @@ kk_image_view_init(struct kk_device *dev, struct kk_image_view *view,
                view->planes[view_plane].mtl_handle_input);
 
          /* Handle mutable formats */
-         view->planes[view_plane].render_is_view = requires_format_change;
-         if (requires_format_change) {
-            view_layout.view_type = original_type;
-            view->planes[view_plane].mtl_handle_render =
-               mtl_new_texture_view_with_no_swizzle(mtl_handle, &view_layout);
-         } else /* Subresource indices will be set in attachment descriptor */
-            view->planes[view_plane].mtl_handle_render = mtl_retain(mtl_handle);
+         if (view->vk.usage & (VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT |
+                               VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT)) {
+            view->planes[view_plane].render_is_view = requires_format_change;
+            if (requires_format_change) {
+               view_layout.view_type = original_type;
+               view->planes[view_plane].mtl_handle_render =
+                  mtl_new_texture_view_with_no_swizzle(mtl_handle, &view_layout);
+            } else /* Subresource indices will be set in attachment descriptor */
+               view->planes[view_plane].mtl_handle_render =
+                  mtl_retain(mtl_handle);
+         }
       }
    }
 
