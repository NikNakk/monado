diff --git a/src/kosmickrisp/bridge/mtl_texture.m b/src/kosmickrisp/bridge/mtl_texture.m
index b4426dc..99482ae 100644
--- a/src/kosmickrisp/bridge/mtl_texture.m
+++ b/src/kosmickrisp/bridge/mtl_texture.m
@@ -13,6 +13,7 @@
 #include "vulkan/vulkan.h"
 
 #include <Metal/MTLTexture.h>
+#include <Metal/MTLDevice.h>
 
 uint64_t
 mtl_texture_get_gpu_resource_id(mtl_texture *texture)
@@ -134,3 +135,20 @@
                   bytesPerImage:data->buffer_2d_image_size_B];
    }
 }
+
+int
+mtl_test_texture_matches(mtl_texture *texture, mtl_device *device,
+                         const struct kk_image_layout *layout)
+{
+   @autoreleasepool {
+      id<MTLTexture> tex = (id<MTLTexture>)texture;
+      id<MTLDevice> dev = (id<MTLDevice>)device;
+      return tex && tex.device.registryID == dev.registryID &&
+             tex.pixelFormat == layout->format.mtl &&
+             tex.textureType == MTLTextureType2D &&
+             tex.width == layout->width_px && tex.height == layout->height_px &&
+             tex.depth == 1 && tex.arrayLength == 1 &&
+             tex.mipmapLevelCount == 1 && tex.sampleCount == 1 &&
+             ((tex.usage & layout->usage) == layout->usage);
+   }
+}
diff --git a/src/kosmickrisp/vulkan/kk_image.c b/src/kosmickrisp/vulkan/kk_image.c
index 5cbf34b..256f7f5 100644
--- a/src/kosmickrisp/vulkan/kk_image.c
+++ b/src/kosmickrisp/vulkan/kk_image.c
@@ -592,6 +592,12 @@ static void
 kk_image_finish(struct kk_device *dev, struct kk_image *image,
                 const VkAllocationCallbacks *pAllocator)
 {
+   if (image->diagnostic_imported) {
+      simple_mtx_lock(&dev->residency_set.mutex);
+      mtl_residency_set_remove_allocation(dev->residency_set.handle,
+                                         image->planes[0].mtl_handle);
+      simple_mtx_unlock(&dev->residency_set.mutex);
+   }
    for (uint8_t plane = 0; plane < image->plane_count; plane++) {
       kk_image_plane_finish(dev, &image->planes[plane], image->vk.create_flags,
                             pAllocator);
@@ -927,6 +933,9 @@ kk_bind_image_memory(struct kk_device *dev, const VkBindImageMemoryInfo *info)
    }
 #endif
 
+   if (image->diagnostic_imported)
+      return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+
    uint64_t offset_B = info->memoryOffset;
    if (image->disjoint) {
       const VkBindImagePlaneMemoryInfo *plane_info =
@@ -1192,3 +1201,39 @@ kk_image_set_label(struct kk_image *image, const char *label)
          mtl_resource_set_label(image->planes[i].mtl_handle_array, label);
    }
 }
+
+PUBLIC VkResult
+kk_test_bind_texture(VkDevice device, VkImage vk_image, void *texture)
+{
+   VK_FROM_HANDLE(kk_device, dev, device);
+   VK_FROM_HANDLE(kk_image, image, vk_image);
+   if (!image || image->vk.base.device != &dev->vk || !texture)
+      return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+   if (image->plane_count != 1 || image->vk.image_type != VK_IMAGE_TYPE_2D ||
+       image->vk.array_layers != 1 || image->vk.mip_levels != 1 ||
+       image->vk.samples != VK_SAMPLE_COUNT_1_BIT || image->vk.create_flags ||
+       image->vk.tiling != VK_IMAGE_TILING_OPTIMAL ||
+       (image->vk.format != VK_FORMAT_R8G8B8A8_UNORM &&
+        image->vk.format != VK_FORMAT_B8G8R8A8_UNORM) ||
+       image->planes[0].mtl_handle ||
+       !mtl_test_texture_matches(texture, dev->mtl_handle,
+                                 &image->planes[0].layout))
+      return VK_ERROR_FORMAT_NOT_SUPPORTED;
+   image->planes[0].mtl_handle = mtl_retain(texture);
+   image->planes[0].addr = mtl_texture_get_gpu_resource_id(texture);
+   simple_mtx_lock(&dev->residency_set.mutex);
+   mtl_residency_set_add_allocation(dev->residency_set.handle, texture);
+   simple_mtx_unlock(&dev->residency_set.mutex);
+   image->diagnostic_imported = true;
+   return VK_SUCCESS;
+}
+
+PUBLIC VkResult
+kk_test_copy_image_texture(VkImage vk_image, void **texture)
+{
+   VK_FROM_HANDLE(kk_image, image, vk_image);
+   if (!image || !texture || !image->diagnostic_imported)
+      return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+   *texture = mtl_retain(image->planes[0].mtl_handle);
+   return *texture ? VK_SUCCESS : VK_ERROR_OUT_OF_HOST_MEMORY;
+}
