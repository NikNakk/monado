+
+int
+mtl_texture_matches(mtl_texture *texture, mtl_device *device,
+                         const struct kk_image_layout *layout)
+{
+   @autoreleasepool {
+      id<MTLTexture> tex = (id<MTLTexture>)texture;
+      id<MTLDevice> dev = (id<MTLDevice>)device;
+      return tex && tex.device.registryID == dev.registryID &&
+             tex.pixelFormat == layout->format.mtl &&
+             tex.textureType == MTLTextureType2D &&
+             tex.width == layout->width_px && tex.height == layout->height_px &&
+             tex.depth == 1 && tex.arrayLength == 1 &&
+             tex.mipmapLevelCount == 1 && tex.sampleCount == 1 &&
+             ((tex.usage & layout->usage) == layout->usage);
+   }
+}
