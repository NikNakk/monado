diff --git a/src/kosmickrisp/vulkan/kk_sync.c b/src/kosmickrisp/vulkan/kk_sync.c
index f44200c..d015a1d 100644
--- a/src/kosmickrisp/vulkan/kk_sync.c
+++ b/src/kosmickrisp/vulkan/kk_sync.c
@@ -7,6 +7,7 @@
 #include "kk_sync.h"
 
 #include "kk_device.h"
+#include "vk_semaphore.h"
 
 #include "kosmickrisp/bridge/mtl_bridge.h"
 
@@ -104,3 +105,115 @@ const struct vk_sync_type kk_sync_type = {
    .export_win32_handle = NULL,
    .set_win32_export_params = NULL,
 };
+
+VkResult
+kk_metal_set_shared_event(VkSemaphore semaphore, void *event)
+{
+   if (!semaphore || !event)
+      return VK_ERROR_INITIALIZATION_FAILED;
+   VK_FROM_HANDLE(vk_semaphore, sem, semaphore);
+   struct vk_sync *sync = vk_semaphore_get_active_sync(sem);
+   if (sem->type != VK_SEMAPHORE_TYPE_TIMELINE || sync->type != &kk_sync_type)
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+   struct kk_sync_timeline *timeline =
+      container_of(sync, struct kk_sync_timeline, base);
+   void *retained = mtl_retain(event);
+   mtl_release(timeline->mtl_handle);
+   timeline->mtl_handle = retained;
+   return VK_SUCCESS;
+}
+
+#include "kk_image.h"
+#include "kk_entrypoints.h"
+#include "kk_physical_device.h"
+#include "vk_common_entrypoints.h"
+#include "kosmickrisp/bridge/kosmickrisp_metal_interop.h"
+
+static uint64_t
+kk_metal_device_registry_id(VkDevice device)
+{
+   VK_FROM_HANDLE(kk_device, dev, device);
+   return mtl_device_get_registry_id(dev->mtl_handle);
+}
+
+static VkResult
+kk_metal_copy_device(VkDevice device, void **out)
+{
+   VK_FROM_HANDLE(kk_device, dev, device);
+   if (!out)
+      return VK_ERROR_INITIALIZATION_FAILED;
+   *out = mtl_retain(dev->mtl_handle);
+   return *out ? VK_SUCCESS : VK_ERROR_OUT_OF_HOST_MEMORY;
+}
+
+static VkResult
+kk_metal_import_image(VkDevice device, const VkImageCreateInfo *info,
+                      void *texture, VkImage *out)
+{
+   if (!out || !info || !texture || info->pNext)
+      return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+   *out = VK_NULL_HANDLE;
+   VkImage image;
+   VkResult result = kk_CreateImage(device, info, NULL, &image);
+   if (result != VK_SUCCESS)
+      return result;
+   result = kk_metal_bind_texture(device, image, texture);
+   if (result != VK_SUCCESS) {
+      kk_DestroyImage(device, image, NULL);
+      return result;
+   }
+   *out = image;
+   return VK_SUCCESS;
+}
+
+static VkResult
+kk_metal_import_timeline(VkDevice device, void *event, uint64_t initial,
+                         VkSemaphore *out)
+{
+   if (!out || !event || mtl_shared_event_get_signaled_value(event) != initial)
+      return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+   *out = VK_NULL_HANDLE;
+   VkSemaphoreTypeCreateInfo type = {
+      .sType = VK_STRUCTURE_TYPE_SEMAPHORE_TYPE_CREATE_INFO,
+      .semaphoreType = VK_SEMAPHORE_TYPE_TIMELINE,
+      .initialValue = initial,
+   };
+   VkSemaphoreCreateInfo info = {
+      .sType = VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO,
+      .pNext = &type,
+   };
+   VkSemaphore semaphore;
+   VkResult result = vk_common_CreateSemaphore(device, &info, NULL, &semaphore);
+   if (result != VK_SUCCESS)
+      return result;
+   result = kk_metal_set_shared_event(semaphore, event);
+   if (result != VK_SUCCESS) {
+      vk_common_DestroySemaphore(device, semaphore, NULL);
+      return result;
+   }
+   *out = semaphore;
+   return VK_SUCCESS;
+}
+
+PUBLIC VkResult
+kk_get_metal_interop_api(uint32_t version, const struct kk_metal_interop_api **out);
+
+PUBLIC VkResult
+kk_get_metal_interop_api(uint32_t version, const struct kk_metal_interop_api **out)
+{
+   static const struct kk_metal_interop_api api = {
+      .abi_version = KK_METAL_INTEROP_ABI_VERSION,
+      .struct_size = sizeof(struct kk_metal_interop_api),
+      .device_registry_id = kk_metal_device_registry_id,
+      .copy_device = kk_metal_copy_device,
+      .import_image = kk_metal_import_image,
+      .import_timeline = kk_metal_import_timeline,
+   };
+   if (!out)
+      return VK_ERROR_INITIALIZATION_FAILED;
+   *out = NULL;
+   if (version != KK_METAL_INTEROP_ABI_VERSION)
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+   *out = &api;
+   return VK_SUCCESS;
+}
