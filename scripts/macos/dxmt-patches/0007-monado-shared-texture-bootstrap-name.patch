From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nick Kennedy <nick@nick-kennedy.com>
Date: Thu, 24 Sep 2026 16:00:00 +0100
Subject: [PATCH] d3d11: expose shared Metal texture bootstrap name

DXMT already backs ordinary shared textures, including Texture2DArray
resources, with an MTLSharedTextureHandle and registers its Mach port under a
unique bootstrap name. Expose that existing name as D3D11 private data so
Monado's Wine client can hand the same Metal texture to the native compositor
without repacking array slices into a separate IOSurface texture.

---
 src/d3d11/d3d11_texture_device.cpp | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/src/d3d11/d3d11_texture_device.cpp b/src/d3d11/d3d11_texture_device.cpp
--- a/src/d3d11/d3d11_texture_device.cpp
+++ b/src/d3d11/d3d11_texture_device.cpp
@@ -314,6 +314,10 @@ public:
   float GetMinLOD() override { return min_lod; }
 };
 
+static const GUID kMonadoSharedTextureBootstrapNameGuid = {
+    0x6f5ee9b2, 0xe42a, 0x4f4d,
+    {0x97, 0x82, 0x1c, 0x73, 0x0f, 0x54, 0x64, 0xb9}};
+
 struct SharedResourceData {
   char mach_port_name[54];
   D3D11_RESOURCE_DIMENSION dimension;
@@ -414,6 +418,12 @@ HRESULT CreateDeviceTextureInternal(MTLD3D11Device *pDevice,
     *ppTexture = reinterpret_cast<typename tag::COM_IMPL *>(
         ref(new DeviceTexture<tag>(&finalDesc, std::move(texture), create.hResource,
                                    create.hGlobalShare, pDevice))
     );
+    /*
+     * Expose DXMT's existing MTLSharedTextureHandle bootstrap registration.
+     * The name is metadata only; the shared Metal storage is not copied.
+     */
+    (*ppTexture)->SetPrivateData(kMonadoSharedTextureBootstrapNameGuid,
+                                 sizeof(runtimeData.mach_port_name), runtimeData.mach_port_name);
     return S_OK;
   }
