+	REQUIRE(xrt_comp_layer_commit_with_semaphore(&f.compositor->base, &gate, 19) == XRT_SUCCESS);
+	bool failed = false;
+	while (!failed && std::chrono::steady_clock::now() - started < std::chrono::seconds(2)) {
+		os_thread_helper_lock(&mc->wait_thread.oth);
