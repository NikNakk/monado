+    XrVector3f DiagnosticPoint(float x, float y, float z) const {
+        return {
+            m_diagnosticOrigin.x + m_diagnosticRight.x * x + m_diagnosticForward.x * z,
+            m_diagnosticOrigin.y + y,
+            m_diagnosticOrigin.z + m_diagnosticRight.z * x + m_diagnosticForward.z * z,
+        };
+    }
+
+    void AddDiagnosticCube(std::vector<Cube>& cubes, float x, float y, float z, float size) const {
+        XrPosef pose = Math::Pose::Identity();
+        pose.position = DiagnosticPoint(x, y, z);
+        cubes.push_back(Cube{pose, {size, size, size}});
+    }
+
+    void InitializeDiagnosticScene() {
+        if (m_diagnosticSceneInitialized || m_views.empty()) {
+            return;
+        }
+
+        m_diagnosticOrigin = {0.0f, 0.0f, 0.0f};
+        for (const XrView& view : m_views) {
+            m_diagnosticOrigin.x += view.pose.position.x;
+            m_diagnosticOrigin.y += view.pose.position.y;
+            m_diagnosticOrigin.z += view.pose.position.z;
+        }
+        const float invViewCount = 1.0f / static_cast<float>(m_views.size());
+        m_diagnosticOrigin.x *= invViewCount;
+        m_diagnosticOrigin.y *= invViewCount;
+        m_diagnosticOrigin.z *= invViewCount;
+
+        const XrVector3f unitForward{0.0f, 0.0f, -1.0f};
+        XrQuaternionf_RotateVector3f(&m_diagnosticForward, &m_views[0].pose.orientation, &unitForward);
+        m_diagnosticForward.y = 0.0f;
+        const float horizontalLength =
+            std::sqrt(m_diagnosticForward.x * m_diagnosticForward.x + m_diagnosticForward.z * m_diagnosticForward.z);
+        if (horizontalLength > 0.001f) {
+            m_diagnosticForward.x /= horizontalLength;
+            m_diagnosticForward.z /= horizontalLength;
+        } else {
+            m_diagnosticForward = {0.0f, 0.0f, -1.0f};
+        }
+        m_diagnosticRight = {-m_diagnosticForward.z, 0.0f, m_diagnosticForward.x};
+
+        // Dotted floor grid: fixed lateral positions at 0.5 m depth intervals.
+        for (float z = 0.75f; z <= 6.01f; z += 0.5f) {
+            for (float x : {-2.0f, -1.0f, 0.0f, 1.0f, 2.0f}) {
+                AddDiagnosticCube(m_diagnosticSceneCubes, x, -1.2f, z, 0.035f);
+            }
+        }
+
+        // Symmetric wall markers at known visual eccentricities.
+        constexpr float Pi = 3.14159265358979323846f;
+        constexpr float wallDepth = 3.0f;
+        for (int degrees = -40; degrees <= 40; degrees += 10) {
+            const float x = std::tan(static_cast<float>(degrees) * Pi / 180.0f) * wallDepth;
+            for (float y : {-0.8f, -0.4f, 0.0f, 0.4f, 0.8f}) {
+                AddDiagnosticCube(m_diagnosticSceneCubes, x, y, wallDepth, 0.04f);
+            }
+        }
+
+        // Same approximate angular target size at several depths.
+        for (float depth : {0.75f, 1.5f, 3.0f, 6.0f}) {
+            const float size = 0.018f * depth;
+            for (int degrees : {-30, 0, 30}) {
+                const float x = std::tan(static_cast<float>(degrees) * Pi / 180.0f) * depth;
+                AddDiagnosticCube(m_diagnosticSceneCubes, x, 0.0f, depth, size);
+            }
+        }
+
+        // Slightly larger central fixation target.
+        AddDiagnosticCube(m_diagnosticSceneCubes, 0.0f, 0.0f, 2.0f, 0.06f);
+        m_diagnosticSceneInitialized = true;
+        Log::Write(Log::Level::Info,
+                   Fmt("PSVR2 diagnostic scene initialized with %zu world-locked cubes", m_diagnosticSceneCubes.size()));
+    }
+
+    void AppendHeadLockedReference(std::vector<Cube>& cubes) const {
+        if (m_views.empty()) {
+            return;
+        }
+
+        XrVector3f eyeCenter{0.0f, 0.0f, 0.0f};
+        for (const XrView& view : m_views) {
+            eyeCenter.x += view.pose.position.x;
+            eyeCenter.y += view.pose.position.y;
+            eyeCenter.z += view.pose.position.z;
+        }
+        const float invViewCount = 1.0f / static_cast<float>(m_views.size());
+        eyeCenter.x *= invViewCount;
+        eyeCenter.y *= invViewCount;
+        eyeCenter.z *= invViewCount;
+
+        const XrVector3f unitForward{0.0f, 0.0f, -1.0f};
+        const XrVector3f unitRight{1.0f, 0.0f, 0.0f};
+        const XrVector3f unitUp{0.0f, 1.0f, 0.0f};
+        XrVector3f headForward;
+        XrVector3f headRight;
+        XrVector3f headUp;
+        XrQuaternionf_RotateVector3f(&headForward, &m_views[0].pose.orientation, &unitForward);
+        XrQuaternionf_RotateVector3f(&headRight, &m_views[0].pose.orientation, &unitRight);
+        XrQuaternionf_RotateVector3f(&headUp, &m_views[0].pose.orientation, &unitUp);
+
+        const XrVector3f center{
+            eyeCenter.x + headForward.x * 0.40f,
+            eyeCenter.y + headForward.y * 0.40f,
+            eyeCenter.z + headForward.z * 0.40f,
+        };
+        const auto addMarker = [&cubes](const XrVector3f& p) {
+            XrPosef pose = Math::Pose::Identity();
+            pose.position = p;
+            cubes.push_back(Cube{pose, {0.008f, 0.008f, 0.008f}});
+        };
+        addMarker(center);
+        for (float sign : {-1.0f, 1.0f}) {
+            addMarker({center.x + sign * headRight.x * 0.025f, center.y + sign * headRight.y * 0.025f,
+                       center.z + sign * headRight.z * 0.025f});
+            addMarker({center.x + sign * headUp.x * 0.025f, center.y + sign * headUp.y * 0.025f,
+                       center.z + sign * headUp.z * 0.025f});
+        }
+    }
